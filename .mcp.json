{
  "mcpServers": {
    "playwright-test": {
      "command": "bun",
      "args": [
        "--cwd=packages/tests",
        "x",
        "playwright",
        "run-test-mcp-server",
        "--headless"
      ]
    },
    "playwright": {
      "command": "bunx",
      "args": ["@playwright/mcp@0.0.83", "--headless"]
    }
  }
}
