{
  "mcpServers": {
    "e2e": {
      "command": "bun",
      "args": [
        "x",
        "e2e",
        "mcp",
        "--config",
        "packages/tests/e2e.config.ts"
      ],
      "env": {
        "E2E_TELEMETRY_DISABLED": "1"
      }
    },
    "workos": {
      "type": "http",
      "url": "https://mcp.workos.com/mcp"
    }
  }
}
