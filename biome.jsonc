{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "plugins": [
    {
      "path": "./scripts/lint/no-raw-identity.grit",
      "includes": [
        "**/packages/convex/**/*.ts",
        "!**/packages/convex/_generated/**",
        "!**/packages/convex/__tests__/**",
        "!**/packages/convex/**/*.test.ts",
        "!**/packages/convex/securitySessions.ts"
      ]
    },
    {
      "path": "./scripts/lint/identity-boundary-callers.grit",
      "includes": [
        "**/packages/convex/**/*.ts",
        "**/apps/**/*.ts",
        "!**/packages/convex/_generated/**",
        "!**/packages/convex/__tests__/**",
        "!**/*.test.ts",
        "!**/packages/convex/securitySessions.ts",
        "!**/packages/convex/workosBootstrap.ts",
        "!**/packages/convex/workosLifecycle.ts",
        "!**/packages/convex/publicApiHttpAuth.ts",
        "!**/packages/convex/workosWebhook.ts"
      ]
    },
    {
      "path": "./scripts/lint/no-remove-child.grit",
      "includes": ["**/apps/web/src/**"]
    },
    {
      "path": "./scripts/lint/no-translucent-icon-color.grit",
      "includes": ["**/*.tsx"]
    }
  ],
  "javascript": {
    "globals": [
      "Bun",
      "chrome",
      "defineBackground",
      "defineContentScript",
      "__DEV__",
      // Safari app + WebExtension runtime globals (committed Safari bundles).
      "browser",
      "webkit"
    ]
  },
  "overrides": [
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.*",
        "**/*.test-utils.*",
        "**/test/**",
        "**/tests/**",
        "**/*.e2e.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      // Generated or vendored files that must stay byte-for-byte as their
      // writers leave them:
      // - SharedConstants.json: apps/apple/scripts/shared-constants.ts,
      //   checked in apps/apple/tests/shared-constants.test.ts
      // - Safari manifests: scripts/release-version.mjs, every release
      // - xcassets Contents.json: Xcode
      // - .agents/skills/workos: vendored (skills-lock.json hashes it)
      "includes": [
        "apps/apple/Packages/TeakKit/Sources/TeakCore/Resources/SharedConstants.json",
        "apps/apple/SafariExtension/Resources/manifest.json",
        "**/*.xcassets/**/Contents.json",
        ".agents/skills/workos/**"
      ],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": [
        "packages/convex/index.ts",
        "packages/convex/shared/index.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/_generated/server", "**/client/**"],
                    "message": "Client barrels must not export Convex function implementations or React hooks."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/raycast/raycast-env.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNamespace": "off"
          },
          "complexity": {
            "noBannedTypes": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.e2e.ts",
        "**/*.test-utils.ts",
        "**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.e2e.ts",
        "!**/__tests__/**",
        "!**/_generated/**",
        "!**/*.d.ts",
        "!apps/web/src/components/ui/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "warn",
              "options": { "maxLines": 1000, "skipBlankLines": true }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/convex/linkMetadata/ssrf.ts",
        "packages/convex/shared/utils/colorUtils.ts",
        "packages/convex/apiKeys.ts",
        "packages/convex/storage/r2.ts",
        "packages/convex/shared/search/shuffle.ts",
        "packages/convex/__tests__/helpers/r2Mock.test-utils.ts",
        "packages/convex/shared/audioWave.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/convex/export/bookmarks.ts",
        "packages/convex/export/constants.ts",
        "packages/convex/export/csv.ts",
        "packages/convex/export/serialize.ts",
        "packages/convex/linkMetadata/ssrf.ts",
        "packages/convex/card/classificationRules.ts",
        "packages/convex/card/documentTextFormat.ts",
        "packages/convex/mcp/protocol.ts",
        "packages/convex/shared/aiPricing.ts",
        "packages/convex/shared/posthog.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "convex",
                      "convex/**",
                      "**/_generated/**",
                      "node:*",
                      "node:*/**",
                      "zod",
                      "zod/**"
                    ],
                    "message": "This module stays free of Convex, Node and zod imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/convex/shared/filesOrigins.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**"],
                    "message": "Repo scripts read this module before dependencies are installed, so it imports nothing."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/convex/storage/fileUrls.ts",
        "packages/convex/storage/r2Keys.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./*", "!./r2Keys"],
                    "message": "Tests mock storage/r2 process-wide, so leaf storage modules import only storage/r2Keys."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/convex/linkMetadata/**",
        "!packages/convex/linkMetadata/ssrf.ts",
        "!packages/convex/linkMetadata/x.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Fetch user-controlled URLs with safeFetch from linkMetadata/ssrf.ts."
                }
              }
            }
          }
        }
      }
    },
    {
      // Plain <img> on purpose: card media and favicons load straight from
      // their source with Teak's own retry and sizing, the browser extension
      // has no next/image, and OG images render through ImageResponse.
      "includes": [
        "apps/web/src/components/card-previews/**",
        "apps/web/src/components/cards/**",
        "apps/extension/**",
        "apps/web/src/app/opengraph-image.tsx"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          }
        }
      }
    },
    {
      // Raycast's AI tool schema extractor (`ray build`) only reads the tool's
      // `Input` when declared as a type alias; interfaces break extraction with
      // "No item type".
      "includes": ["apps/raycast/src/tools/**"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    },
    {
      // Biome does not analyze Astro template expressions, so it reports every
      // frontmatter variable and import as unused even when the template uses
      // them (e.g. `class:list`, `{navLinks.map(...)}`). Astro still
      // typechecks these files during `astro build`.
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      // Raycast's `ray lint` gate enforces Prettier formatting; Biome and
      // Prettier disagree on line breaks, so formatting here belongs to
      // Prettier. Biome lint rules still apply.
      "includes": ["apps/raycast/**"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "apps/extension/**",
        "!apps/extension/entrypoints/background.ts",
        "!apps/extension/lib/oauthAuth.ts",
        "!apps/extension/lib/cardDetails.ts",
        "!apps/extension/lib/saveToTeak.ts",
        "!apps/extension/lib/saveFileToTeak.ts",
        "!apps/extension/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/oauthAuth", "**/oauthAuth.ts"],
                    "message": "lib/oauthAuth is background-worker only. Read the capture owner from lib/captureOwner instead."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "a11y": {
        // Safari's `-apple-system-body` font shorthand is the sanctioned
        // dynamic-type value for Apple-only stylesheets.
        "useGenericFontNames": "off"
      },
      "style": {
        "useFilenamingConvention": "off",
        "useDestructuring": "off",
        "noIncrementDecrement": "off",
        // Requires ES2022 lib (`Array.at`) in the Convex tsconfig.
        "useAtIndex": "off",
        // Requires threading the caught error through every rethrow.
        "useErrorCause": "off"
      },
      "complexity": {
        // Many functions are over the threshold.
        "noExcessiveCognitiveComplexity": "off",
        "noVoid": "off"
      },
      "performance": {
        "noJsxPropsBind": "off",
        "noAwaitInLoops": "off",
        // Namespace imports are the documented idiom for Radix primitives.
        "noNamespaceImport": "off",
        "noBarrelFile": "off",
        "useTopLevelRegex": "off"
      },
      "correctness": {
        // False-positives on workspace aliases and virtual modules (wxt,
        // astro, raycast).
        "noUnresolvedImports": "off",
        // Bundler-resolved monorepo (Next/WXT); extensions would break
        // resolution.
        "useImportExtensions": "off"
      },
      "suspicious": {
        // Shadowed loop/parameter names; renaming risks churn across many
        // files for a readability-only win.
        "noShadow": "off",
        // Biome flags any Astro file without script-y frontmatter (and
        // comment-only generated bundles) as an empty source.
        "noEmptySource": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        // Ultracite 7.9+ enables useSortedKeys; it would reorder object keys
        // across hundreds of files. Key order is often semantic (configs, route
        // definitions) and the churn/blame noise isn't worth it.
        "useSortedKeys": "off"
      }
    }
  }
}
