{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "plugins": [
    {
      "path": "./scripts/lint/no-raw-identity.grit",
      "includes": [
        "**/packages/convex/**/*.ts",
        "!**/packages/convex/_generated/**",
        "!**/packages/convex/__tests__/**",
        "!**/packages/convex/**/*.test.ts",
        "!**/packages/convex/securitySessions.ts",
        "!**/packages/convex/ensureUser.ts"
      ]
    }
  ],
  "javascript": {
    "globals": [
      "Bun",
      "chrome",
      "defineBackground",
      "defineContentScript",
      "__DEV__",
      // Safari app + WebExtension runtime globals (committed Safari bundles).
      "browser",
      "webkit"
    ]
  },
  "overrides": [
    {
      // Generated or vendored files that must stay byte-for-byte as their
      // writers leave them:
      // - SharedConstants.json: apps/apple/scripts/shared-constants.ts,
      //   checked in apps/apple/tests/shared-constants.test.ts
      // - Safari manifests: scripts/release-version.mjs, every release
      // - xcassets Contents.json: Xcode
      // - .agents/skills/workos: vendored (skills-lock.json hashes it)
      "includes": [
        "apps/apple/Packages/TeakKit/Sources/TeakCore/Resources/SharedConstants.json",
        "apps/apple/SafariExtension/Resources/manifest.json",
        "**/*.xcassets/**/Contents.json",
        ".agents/skills/workos/**"
      ],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": [
        "packages/convex/index.ts",
        "packages/convex/shared/index.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/_generated/server", "**/client/**"],
                    "message": "Client barrels must not export Convex function implementations or React hooks."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/raycast/raycast-env.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNamespace": "off"
          },
          "complexity": {
            "noBannedTypes": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.e2e.ts",
        "**/*.test-utils.ts",
        "**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/convex/authNative.ts",
        "packages/convex/linkMetadata/ssrf.ts",
        "packages/convex/shared/utils/colorUtils.ts",
        "packages/convex/apiKeys.ts",
        "packages/convex/storage/r2.ts",
        "packages/convex/__tests__/helpers/r2Mock.test-utils.ts",
        "packages/ui/src/components/cards/previews/AudioWavePreview.tsx",
        "apps/docs/components/HomeAppDemo.astro"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          }
        }
      }
    },
    {
      // Pure modules, unit tested and bundled for any runtime.
      "includes": [
        "packages/convex/export/bookmarks.ts",
        "packages/convex/export/constants.ts",
        "packages/convex/export/csv.ts",
        "packages/convex/export/serialize.ts",
        "packages/convex/linkMetadata/ssrf.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "convex",
                      "convex/**",
                      "**/_generated/**",
                      "node:*",
                      "node:*/**"
                    ],
                    "message": "This module stays free of Convex and Node imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // next/image is unavailable here: shared UI package (consumed outside
      // Next.js), browser extension, and OG-image generation via ImageResponse.
      "includes": [
        "packages/ui/**",
        "apps/extension/**",
        "apps/web/src/app/opengraph-image.tsx"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          }
        }
      }
    },
    {
      // Raycast's AI tool schema extractor (`ray build`) only reads the tool's
      // `Input` when declared as a type alias; interfaces break extraction with
      // "No item type".
      "includes": ["apps/raycast/src/tools/**"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    },
    {
      // Biome does not analyze Astro template expressions, so it reports every
      // frontmatter variable and import as unused even when the template uses
      // them (e.g. `class:list`, `{navLinks.map(...)}`). Astro still
      // typechecks these files during `astro build`.
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      // Raycast's `ray lint` gate enforces Prettier formatting; Biome and
      // Prettier disagree on line breaks, so formatting here belongs to
      // Prettier. Biome lint rules still apply.
      "includes": ["apps/raycast/**"],
      "formatter": {
        "enabled": false
      }
    },
    {
      // The extension's OAuth module keeps sign-in state for the background
      // worker. Only the worker and the save modules it calls may import it,
      // so the popup and content script never bundle it.
      "includes": [
        "apps/extension/**",
        "!apps/extension/entrypoints/background.ts",
        "!apps/extension/lib/oauthAuth.ts",
        "!apps/extension/lib/saveToTeak.ts",
        "!apps/extension/lib/saveFileToTeak.ts",
        "!apps/extension/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/oauthAuth", "**/oauthAuth.ts"],
                    "message": "lib/oauthAuth is background-worker only. Read the capture owner from lib/captureOwner instead."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "a11y": {
        // Static brand SVG assets (logos, badges, icons) are referenced via
        // `<img>`/links where the accessible name comes from `alt`.
        "noSvgWithoutTitle": "off",
        // Safari's `-apple-system-body` font shorthand is the sanctioned
        // dynamic-type value for Apple-only stylesheets.
        "useGenericFontNames": "off"
      },
      "style": {
        "useFilenamingConvention": "off",
        "useDestructuring": "off",
        "noIncrementDecrement": "off",
        // Requires ES2022 lib (`Array.at`) in the Convex tsconfig for 2 sites.
        "useAtIndex": "off",
        // Requires threading the caught error through 26 throw sites; tracked
        // as a separate error-handling pass.
        "useErrorCause": "off"
      },
      "complexity": {
        // ~44 functions over the threshold; refactors tracked separately.
        "noExcessiveCognitiveComplexity": "off",
        "noVoid": "off"
      },
      "performance": {
        "noJsxPropsBind": "off",
        "noAwaitInLoops": "off",
        // Namespace imports are the documented idiom for Radix primitives.
        "noNamespaceImport": "off",
        "noBarrelFile": "off",
        "useTopLevelRegex": "off"
      },
      "correctness": {
        // False-positives on workspace aliases and virtual modules (wxt,
        // astro, raycast).
        "noUnresolvedImports": "off",
        // Bundler-resolved monorepo (Next/WXT); extensions would break
        // resolution.
        "useImportExtensions": "off"
      },
      "suspicious": {
        // ~1,250 occurrences; burn down gradually before enabling.
        "noExplicitAny": "off",
        // Standard `{condition && <jsx/>}` render pattern; the falsy-leak
        // concern is handled by our shared UI primitives.
        "noLeakedRender": "off",
        // Optional chaining and redundant-condition checks are defensive
        // against future shape changes, especially in tests.
        "noUnnecessaryConditions": "off",
        // Shadowed loop/parameter names; renaming risks churn across 14 files
        // for a readability-only win.
        "noShadow": "off",
        // Biome flags any Astro file without script-y frontmatter (and
        // comment-only generated bundles) as an empty source.
        "noEmptySource": "off",
        // Intentional error-swallowing `catch` blocks: comment-only bodies are
        // still flagged, and a trailing `return;` trips noUselessReturn.
        "noEmptyBlockStatements": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        // Ultracite 7.9+ enables useSortedKeys; it would reorder object keys
        // across ~393 files. Key order is often semantic (configs, route
        // definitions) and the churn/blame noise isn't worth it.
        "useSortedKeys": "off"
      }
    }
  }
}
