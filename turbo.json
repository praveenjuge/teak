{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "globalEnv": ["NODE_ENV", "VERCEL_ENV"],
  "globalPassThroughEnv": ["CI", "GITHUB_ACTIONS"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "out/**",
        ".output/**",
        ".vite/**"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "CONVEX_*",
        "EXPO_PUBLIC_*",
        "SENTRY_*",
        "POLAR_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "//#check": {},
    "//#fix": {
      "cache": false
    },
    "check": {
      "dependsOn": ["^check"],
      "cache": false
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.jsonc"],
      "outputs": []
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": ["coverage/**"],
      "env": [
        "CLAUDECODE",
        "AGENT",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "SITE_URL"
      ]
    },
    "typecheck": {
      "outputs": []
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
