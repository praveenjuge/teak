engine biome(1.0)
language js(typescript, jsx)

pattern see_through_color() {
  r"(?s).*(?:^|[\s\x22':])(?:text|fill|stroke)-[a-z][a-z0-9-]*/(?:[0-9]+|\[).*"
}

pattern solid_svg_text_override() {
  r"(?s).*svg[^\s]*\]:text-[a-z][a-z0-9-]*(?:\s|\x22|$).*"
}

pattern svg_selector_with_see_through_color() {
  r"(?s).*svg[^\s]*\]:(?:text|fill|stroke)-[a-z][a-z0-9-]*/(?:[0-9]+|\[).*"
}

pattern icon_name() {
  r"[A-Z].*"
}

pattern see_through_icon_class() {
  and {
    see_through_color(),
    not r"(?s).*placeholder:text-.*",
    not solid_svg_text_override()
  }
}

pattern class_string_with_see_through_svgs() {
  or {
    JsStringLiteralExpression(),
    JsxString()
  } as $string where {
    or {
      $string <: svg_selector_with_see_through_color(),
      and {
        $string <: r"(?s).*svg.*",
        $string <: see_through_color(),
        not $string <: solid_svg_text_override()
      }
    }
  }
}

pattern icon_with_see_through_color() {
  JsxSelfClosingElement(name=$name, attributes=$attributes) where {
    $name <: icon_name(),
    $attributes <: contains JsxAttribute(name=$attribute, initializer=$value) where {
      $attribute <: `className`,
      $value <: see_through_icon_class()
    }
  }
}

pattern see_through_wrapper_around_icon() {
  JsxElement(opening_element=$opening) as $element where {
    $opening <: contains JsxAttribute(name=$attribute, initializer=$value) where {
      $attribute <: `className`,
      $value <: see_through_icon_class()
    },
    $element <: contains JsxSelfClosingElement(name=$child) where {
      $child <: icon_name()
    }
  }
}

or {
  class_string_with_see_through_svgs(),
  icon_with_see_through_color(),
  see_through_wrapper_around_icon()
} as $match where {
  register_diagnostic(span=$match, message="Icons need a solid color: overlapping strokes in a see-through color (text-x/55) show brighter spots. Use a solid color and fade the svg with opacity, e.g. [&>svg]:text-x [&>svg]:opacity-55.", severity="error")
}
