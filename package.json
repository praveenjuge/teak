{
  "name": "teak",
  "version": "1.0.91",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit:env": "bun --no-env-file run scripts/env-audit.ts",
    "build": "bun run --filter '*' build",
    "build:cli": "bun run --filter 'teak-cli...' build",
    "build:extension": "bun run --filter '@teak/extension...' build",
    "build:raycast": "bun run --filter teak-raycast build",
    "check": "ultracite check",
    "check:cloudflare": "bun --no-env-file run scripts/check-cloudflare.ts",
    "clean": "rm -rf node_modules/.cache",
    "dev": "bun --no-env-file run scripts/dev.ts",
    "doctor": "bun --no-env-file run scripts/doctor.ts",
    "fix": "ultracite fix",
    "lint": "bun run --filter '*' lint",
    "pre-commit": "bun --no-env-file run scripts/check-lockfile.ts && bun --no-env-file run scripts/run-affected.ts typecheck lint build",
    "prepare": "[ -f .git ] || simple-git-hooks || exit 0",
    "publish:raycast": "cd apps/raycast && bun run publish",
    "r2:lifecycle": "bun --no-env-file run scripts/cloudflare-r2-lifecycle.ts",
    "release:prepare": "bun --no-env-file run scripts/release-prepare.ts",
    "setup": "bun --no-env-file run scripts/setup.ts",
    "smoke:web": "bun --no-env-file run scripts/smoke-web-session.ts",
    "start": "bun run --filter '*' build && bun run --parallel --filter '*' start",
    "sync:cloudflare-dev": "bun --no-env-file run scripts/sync-files-worker-dev-secret.ts",
    "test": "bun run --filter '*' test && bun --no-env-file test scripts/ apps/apple/tests/ apps/android/tests/",
    "typecheck": "bun run --filter '*' typecheck",
    "verify": "bun --no-env-file run scripts/run-affected.ts typecheck lint test",
    "verify:all": "bun run typecheck && bun run lint && bun run --filter '*' test",
    "waf": "bun --no-env-file run scripts/cloudflare-waf.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run pre-commit"
  },
  "overrides": {
    "@scalar/json-magic": {
      "undici": "7.30.1"
    },
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "convex": "1.46.0",
    "convex-helpers": "0.1.128",
    "esbuild": "0.28.2",
    "lodash-es": "4.18.1",
    "miniflare": {
      "undici": "7.30.1"
    },
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "js-yaml": "5.4.3",
    "lru-cache": "11.5.3",
    "simple-git-hooks": "^2.13.1",
    "ultracite": "7.12.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "24.21.0"
  },
  "trustedDependencies": [
    "@posthog/cli",
    "@teak/extension",
    "esbuild",
    "sharp",
    "simple-git-hooks",
    "workerd"
  ]
}
