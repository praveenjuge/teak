{
  "name": "teak",
  "version": "1.0.91",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit:env": "bun --no-env-file run scripts/env-audit.ts",
    "build": "turbo run build",
    "build:cli": "turbo run build --filter=teak-cli",
    "build:extension": "turbo run build --filter=@teak/extension",
    "build:raycast": "turbo run build --filter=./apps/raycast",
    "check": "ultracite check",
    "check:cloudflare": "bun --no-env-file run scripts/check-cloudflare.ts",
    "clean": "test ! -d .turbo/daemon || turbo daemon clean && rm -rf node_modules/.cache && find . \\( -name node_modules -o -name .git \\) -prune -o -name .turbo -type d -prune -exec rm -rf {} +",
    "dev": "bun --no-env-file run scripts/dev.ts",
    "doctor": "bun --no-env-file run scripts/doctor.ts",
    "fix": "ultracite fix",
    "lint": "turbo run lint",
    "pre-commit": "bun --no-env-file run scripts/check-lockfile.ts && turbo run typecheck lint build --affected",
    "prepare": "[ -f .git ] || simple-git-hooks || exit 0",
    "publish:raycast": "cd apps/raycast && bun run publish",
    "r2:lifecycle": "bun --no-env-file run scripts/cloudflare-r2-lifecycle.ts",
    "release:prepare": "bun --no-env-file run scripts/release-prepare.ts",
    "setup": "bun --no-env-file run scripts/setup.ts",
    "smoke:web": "bun --no-env-file run scripts/smoke-web-session.ts",
    "start": "turbo run start",
    "sync:cloudflare-dev": "bun --no-env-file run scripts/sync-core-worker-dev-secret.ts",
    "test": "turbo run test && bun --no-env-file test scripts/ apps/apple/tests/ apps/android/tests/",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run typecheck lint test --affected",
    "verify:all": "turbo run typecheck lint test",
    "waf": "bun --no-env-file run scripts/cloudflare-waf.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run pre-commit"
  },
  "overrides": {
    "@scalar/json-magic": {
      "undici": "7.30.1"
    },
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "convex": "1.46.0",
    "convex-helpers": "0.1.128",
    "esbuild": "0.28.2",
    "lodash-es": "4.18.1",
    "miniflare": {
      "undici": "7.30.1"
    },
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "js-yaml": "5.4.3",
    "lru-cache": "11.5.3",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.11.7",
    "ultracite": "7.12.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "24.21.0"
  },
  "catalog": {
    "@cf-wasm/photon": "^0.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workos-inc/node": "10.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.128",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "jose": "6.2.12",
    "marked": "17.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "use-intl": "4.14.9",
    "vadivam-react": "^0.0.69",
    "wrangler": "^4.151.0",
    "zod": "4.6.7"
  },
  "trustedDependencies": [
    "@posthog/cli",
    "@teak/extension",
    "esbuild",
    "sharp",
    "simple-git-hooks",
    "workerd"
  ]
}
