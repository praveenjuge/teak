                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Remove “%2$@” de %1$lld card, incluindo os que estão no Arquivo ou na Lixeira. Os cards são mantidos. Isso não pode ser desfeito."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
