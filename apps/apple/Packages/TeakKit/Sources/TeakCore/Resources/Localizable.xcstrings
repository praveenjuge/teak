        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas con la etiqueta «%1$@» pasarán a tener la etiqueta que elija. Si una tarjeta tiene ambas, conserva una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fiches portant le tag « %1$@ » reçoivent à la place le tag que vous choisissez. Une fiche qui a les deux n’en garde qu’un."
          }
        },
        "ja" : {
