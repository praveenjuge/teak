      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten mit dem Tag „%1$@“ erhalten stattdessen den gewählten Tag. Hat eine Karte beide, bleibt einer erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards tagged “%1$@” get the tag you pick instead. A card with both keeps one."
