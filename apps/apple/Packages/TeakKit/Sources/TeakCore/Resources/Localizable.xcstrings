    "native.auth.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr persönliches System für alles. Organisieren, speichern und öffnen Sie all Ihre Texte, Bilder und Dokumente an einem Ort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your personal everything management system. Organize, save, and access all your text, images, and documents in one place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su sistema personal para gestionarlo todo. Organice, guarde y consulte todos sus textos, imágenes y documentos en un solo lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre système personnel pour tout gérer. Organisez, enregistrez et retrouvez tous vos textes, images et documents au même endroit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あらゆるものを管理できる、あなた専用のシステム。テキスト、画像、ドキュメントをひとつの場所で整理・保存して、いつでも開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 것을 관리하는 나만의 시스템입니다. 텍스트, 이미지, 문서를 한곳에서 정리하고 저장하고 꺼내 볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu sistema pessoal para gerenciar tudo. Organize, salve e acesse todos os seus textos, imagens e documentos em um só lugar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的个人万物管理系统。在一个地方整理、保存和访问你的所有文本、图片和文档。"
          }
        }
      }
    },
