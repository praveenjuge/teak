        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방금 휴지통을 여러 번 비웠습니다. 1분 후에 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
