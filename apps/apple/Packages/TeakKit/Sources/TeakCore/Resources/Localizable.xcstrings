    "native.folders.smartMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt jede Karte, die zur Suche passt, auch Karten, die Sie später speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows every card that matches the search, including cards you save later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra todas las tarjetas que coinciden con la búsqueda, incluidas las que guarde más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche toutes les fiches qui correspondent à la recherche, y compris celles que vous enregistrerez plus tard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索条件に一致するすべてのカードを表示します。あとで保存したカードも含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나중에 저장하는 카드를 포함해 검색과 일치하는 모든 카드를 보여 줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra todos os cards que correspondem à pesquisa, inclusive os que você salvar depois."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示符合搜索条件的所有卡片，包括你以后保存的卡片。"
          }
        }
      }
    },
    "native.folders.smartMessageDropsFilters" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt jede Karte, die zur Suche passt, auch Karten, die Sie später speichern. Farben, Stile und Datumsangaben werden in einem intelligenten Ordner nicht gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows every card that matches the search, including cards you save later. Colors, styles and dates aren't saved in a smart folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra todas las tarjetas que coinciden con la búsqueda, incluidas las que guarde más adelante. Los colores, los estilos y las fechas no se guardan en una carpeta inteligente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche toutes les fiches qui correspondent à la recherche, y compris celles que vous enregistrerez plus tard. Les couleurs, styles et dates ne sont pas enregistrés dans un dossier intelligent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索条件に一致するすべてのカードを表示します。あとで保存したカードも含まれます。色、スタイル、日付はスマートフォルダに保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나중에 저장하는 카드를 포함해 검색과 일치하는 모든 카드를 보여 줍니다. 색상, 스타일, 날짜는 스마트 폴더에 저장되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra todos os cards que correspondem à pesquisa, inclusive os que você salvar depois. Cores, estilos e datas não são salvos em uma pasta inteligente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示符合搜索条件的所有卡片，包括你以后保存的卡片。颜色、风格和日期不会保存在智能文件夹中。"
          }
