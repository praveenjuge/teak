    "native.settings.deleteWarning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden Ihr Konto, Ihre Karten, Tags und hochgeladenen Dateien endgültig entfernt. Sind Sie sicher?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently remove your account, cards, tags, and uploaded files. Are you sure?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán de forma permanente su cuenta, sus tarjetas, sus etiquetas y los archivos que haya subido. ¿Está seguro?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte, vos fiches, vos tags et vos fichiers importés seront définitivement supprimés. Voulez-vous continuer ?"
