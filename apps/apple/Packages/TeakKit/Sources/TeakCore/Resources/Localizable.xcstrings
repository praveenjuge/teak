    "native.settings.safariHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichern Sie Seiten aus Safari mit einem Tippen. Tippen Sie in Safari in der Adressleiste auf %1$@, wählen Sie „Erweiterungen verwalten“ und aktivieren Sie Teak."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save pages from Safari with one tap. In Safari, tap %1$@ in the address bar, choose Manage Extensions, and turn on Teak."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde páginas desde Safari con un toque. En Safari, toque %1$@ en la barra de direcciones, elija Gestionar extensiones y active Teak."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez des pages depuis Safari d’un simple toucher. Dans Safari, touchez %1$@ dans la barre d’adresse, choisissez Gérer les extensions, puis activez Teak."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari からワンタップでページを保存できます。Safari のアドレスバーで %1$@ をタップし、“機能拡張を管理”を選択して Teak をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari에서 한 번만 탭하면 페이지를 저장할 수 있습니다. Safari 주소 막대에서 %1$@을(를) 탭하고 확장 프로그램 관리를 선택한 다음 Teak을 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve páginas do Safari com um toque. No Safari, toque em %1$@ na barra de endereço, escolha Gerenciar Extensões e ative o Teak."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Safari 浏览器中轻点一下即可保存网页。在 Safari 浏览器中，轻点地址栏中的 %1$@，选择“管理扩展”，然后开启 Teak。"
          }
        }
      }
    },
    "native.settings.safariWhere" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie in Safari „Safari > Einstellungen > Erweiterungen“ und aktivieren Sie Teak."
