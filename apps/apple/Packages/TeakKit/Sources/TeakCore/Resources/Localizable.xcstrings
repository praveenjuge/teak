    "native.tags.deleteMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Entfernt „%2$@“ von %1$lld Karte, auch von Karten im Archiv oder Papierkorb. Die Karten bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Entfernt „%2$@“ von %1$lld Karten, auch von Karten im Archiv oder Papierkorb. Die Karten bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Removes “%2$@” from %1$lld card, plus any in Archive or Trash. The cards are kept. This can't be undone."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Removes “%2$@” from %1$lld cards, plus any in Archive or Trash. The cards are kept. This can't be undone."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Quita «%2$@» de %1$lld tarjeta, además de las que estén en el archivo o en la papelera. Las tarjetas se conservan. No se puede deshacer."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Quita «%2$@» de %1$lld tarjetas, además de las que estén en el archivo o en la papelera. Las tarjetas se conservan. No se puede deshacer."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Retire « %2$@ » de %1$lld fiche, ainsi que de celles des Archives ou de la corbeille. Les fiches sont conservées. Cette action est irréversible."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Retire « %2$@ » de %1$lld fiches, ainsi que de celles des Archives ou de la corbeille. Les fiches sont conservées. Cette action est irréversible."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld 件のカードから「%2$@」を削除します。アーカイブとゴミ箱にあるカードも対象です。カード自体は残ります。この操作は元に戻せません。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "보관함이나 휴지통에 있는 카드를 포함해 카드 %1$lld개에서 “%2$@”을(를) 제거합니다. 카드는 유지됩니다. 이 작업은 되돌릴 수 없습니다."
