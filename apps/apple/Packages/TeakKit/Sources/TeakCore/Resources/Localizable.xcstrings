      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Ihrem Konto gespeichert, damit es Ihnen auf jedes Gerät folgt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
