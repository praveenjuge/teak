    "native.settings.languageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Ihrem Konto gespeichert, damit es Ihnen auf jedes Gerät folgt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved to your account, so it follows you to every device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda en su cuenta, así que le acompaña en todos sus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrée dans votre compte, elle vous suit sur tous vos appareils."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントに保存されるため、すべてのデバイスで同じ設定になります。"
