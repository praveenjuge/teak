{
  "name": "@teak/mobile",
  "version": "1.0.82",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform web --clear",
    "build:sentry": "sentry-cli build upload --org teakvault --project teak-mobile-prod --build-configuration production",
    "dev": "expo start",
    "eas-build-pre-install": "node scripts/verify-sentry-build-env.mjs",
    "ios": "expo run:ios",
    "lint": "biome check .",
    "test": "bun test __tests__ --isolate --coverage --dots",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ui": "~57.0.22",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "8.22.0",
    "@teak/convex": "workspace:*",
    "convex": "^1.46.0",
    "convex-helpers": "0.1.122",
    "expo": "~57.0.27",
    "expo-application": "~57.0.2",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.14",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "sf-symbols-typescript": "^2.2.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@sentry/cli": "3.6.2",
    "@types/react": "~19.2.18",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "react",
        "react-dom"
      ]
    }
  }
}
