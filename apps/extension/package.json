{
  "name": "@teak/extension",
  "version": "1.0.91",
  "description": "Teak - Your Personal Knowledge Hub. Save, organize, and rediscover web content, text selections, and ideas effortlessly.",
  "homepage": "https://teakvault.com",
  "author": "Praveen Juge (hi@praveenjuge.com)",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "dev": "wxt --port ${EXTENSION_PORT:-3003}",
    "dev:firefox": "wxt -b firefox",
    "postinstall": "wxt prepare",
    "test": "bun test __tests__ --coverage --dots",
    "typecheck": "tsc --noEmit",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@radix-ui/react-slot": "catalog:",
    "@teak/convex": "workspace:*",
    "@teak/i18n": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "convex": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "teak-sdk": "workspace:*",
    "vadivam": "^0.0.69",
    "vadivam-react": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wxt": "^0.21.3"
  }
}
