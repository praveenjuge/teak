{
  "name": "@teak/extension",
  "version": "1.0.91",
  "description": "Teak - Your Personal Knowledge Hub. Save, organize, and rediscover web content, text selections, and ideas effortlessly.",
  "homepage": "https://teakvault.com",
  "author": "Praveen Juge (hi@praveenjuge.com)",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "dev": "wxt --port ${EXTENSION_PORT:-3003}",
    "dev:firefox": "wxt -b firefox",
    "postinstall": "wxt prepare",
    "test": "bun test __tests__ --coverage --dots",
    "typecheck": "tsc --noEmit",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@teak/convex": "workspace:*",
    "@teak/i18n": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "teak-sdk": "workspace:*",
    "vadivam": "^0.0.66",
    "vadivam-react": "^0.0.66"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wxt": "^0.21.3"
  }
}
