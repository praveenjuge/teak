{
  // Deployed by `bun run deploy` after `bun run build` writes dist/. worker.ts
  // runs first (run_worker_first) to answer `Accept: text/markdown` requests;
  // everything else is served from the assets. The Core Worker routes on
  // teakvault.com (/api, /mcp, /.well-known) run before this Custom Domain.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "teak-site",
  "main": "worker.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "teakvault.com", "custom_domain": true },
    { "pattern": "www.teakvault.com", "custom_domain": true }
  ]
}
