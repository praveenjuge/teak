{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["bun"],
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "blume.config.ts",
    "components.ts",
    "content/**/*.ts",
    "lib/**/*.ts",
    "pages/**/*.astro",
    "layouts/**/*.astro",
    "components/**/*.astro",
    "vercel.json"
  ]
}
