---
import AppsGrid from "../components/AppsGrid.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
---

<MarketingLayout
  title="Teak Apps | Mac, iPhone, Web, and Extensions"
  description="Save ideas with Teak for Mac, iPhone, web, browser extensions, and Raycast. Connect your library through the API, MCP, CLI, and agent skills."
  canonical="https://teakvault.com/apps"
  ogTitle="Teak Apps"
  ogDescription="Save ideas with Teak for Mac, iPhone, web, browser extensions, and Raycast. Connect your library through the API, MCP, CLI, and agent skills."
  keywords="teak mac app, teak apps, teak api, teak mcp, teak cli, teak agent skill, skills.sh teak, teak ios, teak chrome extension, teak for mac, teak raycast extension, teak web app, visual bookmarking apps, cross platform inspiration"
>
  <main class="px-4 py-16">
    <section class="mx-auto flex max-w-md flex-col items-center gap-4 text-center">
      <h1 class="text-balance font-bold text-4xl tracking-tighter md:text-5xl">
        Teak, everywhere you create
      </h1>
      <p class="text-lg text-muted-foreground">
        Mac, web, API, iPhone, Chrome, Safari, Raycast, CLI, and agent
        skills stay perfectly in sync so the inspiration you save once is
        waiting on every device.
      </p>
    </section>
    <AppsGrid />
  </main>
</MarketingLayout>
