---
import AppsGrid from "../components/AppsGrid.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { SIGN_UP_URL } from "../lib/app-entry";
---

<MarketingLayout
  title="Teak Apps | Mac, iPhone, Web, and Extensions"
  description="Save ideas with Teak on Mac, iPhone, and iPad, web, Chrome and Firefox extensions, and Raycast, with Android coming soon. Connect your library through the API, MCP, CLI, and agent skills."
  canonical="https://teakvault.com/apps"
  ogTitle="Teak Apps"
  ogDescription="Save ideas with Teak on Mac, iPhone, and iPad, web, Chrome and Firefox extensions, and Raycast, with Android coming soon. Connect your library through the API, MCP, CLI, and agent skills."
  keywords="teak mac app, teak apps, teak api, teak mcp, teak cli, teak agent skill, skills.sh teak, teak ios, teak ipad, teak android, teak chrome extension, teak firefox extension, teak firefox add-on, teak raycast extension, teak web app, visual bookmarking apps, cross platform inspiration"
>
  <main class="px-4 pt-14 pb-20">
    <section class="mx-auto flex max-w-xl flex-col items-center text-center">
      <h1 class="text-[clamp(2.125rem,4.4vw,3.125rem)] leading-[1.04] font-bold tracking-[-0.04em] text-balance">
        Teak, everywhere you create
      </h1>
      <p class="mt-4 max-w-lg text-base leading-[1.6] text-balance text-muted-foreground">
        Save on your phone, find it on your Mac, and hand it to your agents.
        One library, in sync on every device.
      </p>
      <a class="mt-6 inline-flex h-10 items-center justify-center rounded-full bg-primary px-7 text-sm font-medium whitespace-nowrap text-primary-foreground no-underline transition-colors hover:bg-primary/90" data-app-entry href={SIGN_UP_URL} rel="noopener noreferrer" target="_blank">Start free →</a>
    </section>

    <AppsGrid />
  </main>
</MarketingLayout>
