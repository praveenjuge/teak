---
import Accordion from "blume/components/content/Accordion.astro";
import AccordionItem from "blume/components/content/AccordionItem.astro";
import Icon from "blume/components/Icon.astro";
import PricingCard from "../components/PricingCard.astro";
import PricingToggle from "../components/PricingToggle.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { SIGN_UP_URL, WEB_APP_URL } from "../lib/app-entry";
import { buildPageSchemas, buildProductSchema, SITE_URL } from "../lib/jsonld";
import {
  FREE_CARD_LIMIT,
  formatUsd,
  PRO_MONTHLY_PRICE,
  PRO_YEARLY_PRICE,
  yearlyPerMonth,
  yearlySavingsPercent,
} from "../lib/pricing";

const monthly = formatUsd(PRO_MONTHLY_PRICE);
const perMonth = formatUsd(yearlyPerMonth());
const savings = `${yearlySavingsPercent()}%`;
const registerHref = SIGN_UP_URL;
const githubHref = "https://github.com/praveenjuge/teak";
const selfHostingHref = "/docs/self-hosting";

const pricingPlans = [
  {
    id: "free",
    name: "Free",
    emojiAlt: "Gift box emoji",
    emojiSrc: "/emojis/pricing-free-gift-box.webp",
    price: "$0",
    priceNote: "Free forever",
    features: [
      `${FREE_CARD_LIMIT} cards, yours to keep`,
      "Links, images, notes, video, audio, docs, palettes, quotes",
      "AI tags, summaries, and transcripts",
      "Search by words, colors, and dates",
      { text: "Every app and extension", href: "/apps" },
      "API, MCP, and CLI access",
      "One-click export, zero lock-in",
    ],
    cta: { text: "Start Free", href: registerHref },
  },
  {
    id: "pro",
    name: "Pro",
    emojiAlt: "Crown emoji",
    emojiSrc: "/emojis/pricing-pro-crown.webp",
    price: {
      monthly: { amount: monthly, period: "month", note: "Billed monthly" },
      yearly: {
        amount: perMonth,
        period: "month",
        note: `Billed yearly at ${formatUsd(PRO_YEARLY_PRICE)}`,
      },
    },
    features: [
      "Everything in Free",
      "Unlimited cards",
      "Priority email support",
      "30-day money-back guarantee",
    ],
    cta: {
      text: "Get Pro",
      href: registerHref,
      signedInHref: `${WEB_APP_URL}/settings/plan`,
      primary: true,
    },
    popular: true,
  },
  {
    id: "self-hosted",
    name: "Self-Hosted",
    emojiAlt: "Server rack emoji",
    emojiSrc: "/emojis/pricing-self-hosted-server-rack.webp",
    price: "$0",
    priceNote: "Open source, on your servers",
    features: [
      "Every feature, unlimited cards",
      "MIT licensed",
      "You run it and pay for the services it uses",
      { text: "Code and support on GitHub", href: githubHref },
    ],
    cta: { text: "Read the setup guide", href: selfHostingHref },
  },
] as const;

type Cell = boolean | string;
interface ComparisonRow {
  feature: string;
  free: Cell;
  pro: Cell;
  self: Cell;
}
const comparison: { group: string; rows: ComparisonRow[] }[] = [
  {
    group: "Library",
    rows: [
      {
        feature: "Cards",
        free: String(FREE_CARD_LIMIT),
        pro: "Unlimited",
        self: "Unlimited",
      },
      {
        feature: "Card types, AI tags, and search",
        free: true,
        pro: true,
        self: true,
      },
      {
        feature: "Import and one-click export",
        free: true,
        pro: true,
        self: true,
      },
    ],
  },
  {
    group: "Apps and API",
    rows: [
      { feature: "Every app and extension", free: true, pro: true, self: true },
      { feature: "API, MCP, and CLI", free: true, pro: true, self: true },
    ],
  },
  {
    group: "Hosting and support",
    rows: [
      {
        feature: "Hosting and updates",
        free: "Included",
        pro: "Included",
        self: "You run it",
      },
      { feature: "Support", free: "Email", pro: "Priority", self: "GitHub" },
    ],
  },
];
const plans = ["free", "pro", "self"] as const;

const assurances = [
  {
    icon: "rotate-ccw",
    title: "30-day refund",
    text: "Not for you? New Pro subscriptions get every penny back.",
  },
  {
    icon: "download",
    title: "Export any time",
    text: "Download every card, with its original files, as one ZIP.",
  },
  {
    icon: "github",
    title: "Open source",
    text: "MIT licensed, so you can always run Teak yourself.",
  },
];

const pricingFaqs = [
  {
    question: `What happens when I hit ${FREE_CARD_LIMIT} cards?`,
    answer: `Your ${FREE_CARD_LIMIT} cards stay safe forever. You just can’t add more until you go Pro or self-host. We never delete your cards.`,
  },
  {
    question: "Should I choose Pro or self-hosting?",
    answer:
      "Both have every feature and unlimited cards. With Pro, we host and update Teak for you. Self-hosting is free under the MIT license, but you run the servers and pay for the services they use.",
  },
  {
    question: `Why ${FREE_CARD_LIMIT} cards?`,
    answer: `${FREE_CARD_LIMIT} cards hold your most important finds, and every feature works on Free. When you need more room, Pro is unlimited.`,
  },
  {
    question: "Can I switch plans anytime?",
    answer: `Yes. Move from monthly to yearly (save ${savings}), upgrade, downgrade, or cancel from Settings → Plan, and export your data with one click whenever you like.`,
  },
  {
    question: "Can I get a refund?",
    answer:
      "Yes. New Pro subscriptions get a full refund within 30 days, no questions asked.",
  },
  {
    question: "Is my data private?",
    answer:
      "Yes. Your cards are encrypted in transit and at rest, and we never share your content for advertising. Product analytics see that you saved a card, never what’s in it.",
  },
  {
    question: "What if Teak ever shuts down?",
    answer:
      "You can export everything, with original files, as a ZIP at any time. And because Teak is open source under the MIT license, you can always run it yourself.",
  },
] as const;

const productSchema = buildProductSchema(
  "Teak Pro",
  "Unlimited cards in Teak for saving and finding links, images, notes, and files.",
  [
    { name: "Teak Pro - Monthly", price: PRO_MONTHLY_PRICE.toFixed(2) },
    { name: "Teak Pro - Yearly", price: PRO_YEARLY_PRICE.toFixed(2) },
  ]
);

const pageSchemas = buildPageSchemas({
  title: "Pricing",
  description: `Try Teak free with ${FREE_CARD_LIMIT} cards. Pro is ${perMonth}/month billed yearly, or ${monthly} monthly.`,
  url: `${SITE_URL}/pricing`,
  breadcrumbs: [
    { name: "Home", url: SITE_URL },
    { name: "Pricing", url: `${SITE_URL}/pricing` },
  ],
  faqs: [...pricingFaqs],
});

const metaTitle = `Simple Pricing. ${FREE_CARD_LIMIT} Cards Free.`;
const metaDescription = `Try Teak free with ${FREE_CARD_LIMIT} cards and every feature. Pro is ${perMonth}/month billed yearly, or ${monthly} monthly. Or self-host the open-source code.`;
---

<MarketingLayout
  title={metaTitle}
  description={metaDescription}
  canonical="https://teakvault.com/pricing"
  ogTitle={metaTitle}
  ogDescription={metaDescription}
  keywords="teak pricing, teak pro, bookmark manager pricing, visual bookmarking pricing, self-hosted bookmark manager, open source bookmark manager"
  jsonLd={[...pageSchemas, productSchema]}
>
  <main class="px-4 pt-14 pb-20">
    <section class="mx-auto flex max-w-xl flex-col items-center text-center">
      <h1 class="text-[clamp(2.125rem,4.4vw,3.125rem)] leading-[1.04] font-bold tracking-[-0.04em] text-balance">
        Simple pricing. Every feature, from day one.
      </h1>
      <p class="mt-4 max-w-md text-base leading-[1.6] text-balance text-muted-foreground">
        Start free with {FREE_CARD_LIMIT} cards. Go unlimited the day your
        library outgrows them.
      </p>
    </section>

    <section aria-label="Plans" class="mx-auto mt-12 max-w-5xl">
      <PricingToggle />
      <div class="plans mx-auto grid max-w-md gap-4">
        {pricingPlans.map((plan) => (
          <PricingCard
            name={plan.name}
            emojiAlt={plan.emojiAlt}
            emojiSrc={plan.emojiSrc}
            features={plan.features}
            price={plan.price}
            priceNote={"priceNote" in plan ? plan.priceNote : undefined}
            ctaText={plan.cta.text}
            ctaHref={plan.cta.href}
            ctaPrimary={"primary" in plan.cta && plan.cta.primary}
            ctaSignedInHref={"signedInHref" in plan.cta ? plan.cta.signedInHref : undefined}
            popular={"popular" in plan && plan.popular}
          />
        ))}
      </div>
    </section>

    <section aria-label="Our promises" class="mx-auto mt-16 max-w-5xl">
      <ul class="assurances grid list-none gap-4 p-0">
        {assurances.map((item) => (
          <li class="flex gap-3">
            <span class="assurance-icon">
              <Icon name={item.icon} size={16} />
            </span>
            <div>
              <p class="text-sm font-semibold">{item.title}</p>
              <p class="mt-0.5 text-sm leading-relaxed text-pretty text-muted-foreground">{item.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="compare-title" class="mx-auto mt-20 max-w-5xl">
      <h2 class="mx-auto mb-8 max-w-md text-center text-2xl font-bold tracking-tight text-balance" id="compare-title">Same Teak on every plan. Only the room changes.</h2>
      <div class="overflow-x-auto">
        <table class="compare w-full border-collapse text-[0.8125rem] md:text-sm">
          <thead>
            <tr>
              <th class="py-3 pr-4 text-left font-normal" scope="col"><span class="sr-only">Feature</span></th>
              <th class="plan-col" scope="col">Free</th>
              <th class="plan-col plan-col-pro" scope="col">Pro</th>
              <th class="plan-col" scope="col">Self-Hosted</th>
            </tr>
          </thead>
          {comparison.map(({ group, rows }) => (
            <tbody>
              <tr>
                <th class="group-row" scope="colgroup">{group}</th>
                {plans.map((plan) => (
                  <td class:list={["group-row", { "plan-cell-pro": plan === "pro" }]} />
                ))}
              </tr>
              {rows.map((row) => (
                <tr class="border-b border-border/70">
                  <th class="py-3.5 pr-3 text-left font-normal text-muted-foreground md:pr-4" scope="row">{row.feature}</th>
                  {plans.map((plan) => {
                    const value = row[plan];
                    return (
                      <td class:list={["px-1 py-3.5 text-center md:px-2", { "plan-cell-pro": plan === "pro" }]}>
                        {value === true ? (
                          <Icon class="mx-auto text-primary" label="Included" name="check" size={16} />
                        ) : value === false ? (
                          <span class="text-muted-foreground">—</span>
                        ) : (
                          value
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </section>

    <section aria-labelledby="faq-title" class="mx-auto mt-20 max-w-2xl">
      <h2 class="mb-8 text-center text-2xl font-bold tracking-tight" id="faq-title">Questions, answered</h2>
      <Accordion>
        {pricingFaqs.map((faq) => (
          <AccordionItem title={faq.question}>
            <p class="text-muted-foreground">{faq.answer}</p>
          </AccordionItem>
        ))}
      </Accordion>
    </section>
  </main>
</MarketingLayout>

<style>
  @media (min-width: 48rem) {
    .assurances {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .plans {
      max-width: none;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .assurance-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    border-radius: 0.625rem;
    background: var(--card);
    color: var(--primary);
  }

  .plan-col {
    width: 4.75rem;
    padding: 0.75rem 0.25rem;
    font-weight: 600;
    text-align: center;
  }

  @media (min-width: 48rem) {
    .plan-col {
      width: 10rem;
    }
  }

  .plan-col-pro,
  .plan-cell-pro {
    background: color-mix(in oklab, var(--primary) 5%, transparent);
  }

  .plan-col-pro {
    border-radius: 0.75rem 0.75rem 0 0;
    color: var(--primary);
  }

  .compare tbody:last-of-type tr:last-child .plan-cell-pro {
    border-radius: 0 0 0.75rem 0.75rem;
  }

  .compare tbody:last-of-type tr:last-child {
    border-bottom: 0;
  }

  .group-row {
    padding: 1.75rem 0 0.5rem;
    border-bottom: 1px solid var(--border);
    color: var(--foreground);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: left;
    text-transform: uppercase;
  }

  .compare tbody:first-of-type .group-row {
    padding-top: 0.75rem;
  }
</style>
