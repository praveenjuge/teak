---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import data from "blume:data";
import Icon from "blume/components/Icon.astro";
import { getBlumeCollection } from "blume/runtime";
import ChangelogBody from "../components/ChangelogBody.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";

type DocsEntry = CollectionEntry<"docs">;

const entries = (await getCollection("docs"))
  .filter(
    (entry: DocsEntry) => entry.data.type === "changelog" && !entry.data.draft
  )
  .sort((a: DocsEntry, b: DocsEntry) => {
    const aDate = new Date(a.data.date ?? 0).getTime();
    const bDate = new Date(b.data.date ?? 0).getTime();
    return bDate - aDate;
  });

const routeByEntry = new Map(
  getBlumeCollection(data, { prefix: "/changelog/" }).map((route) => [
    route.entryId,
    route.path,
  ])
);

const renderedEntries = await Promise.all(
  entries.map(async (entry: DocsEntry) => {
    const { Content } = await render(entry);
    const id = entry.data.title.toLowerCase().replaceAll(/\s+/g, "-");
    return { entry, Content, href: routeByEntry.get(entry.id), id };
  })
);

// Months grouped by year for the sticky month list.
const years: { months: { id: string; month: string }[]; year: string }[] = [];
for (const { entry, id } of renderedEntries) {
  const [month = entry.data.title, year = ""] = entry.data.title.split(" ");
  const group = years.at(-1);
  if (group && group.year === year) {
    group.months.push({ id, month });
  } else {
    years.push({ year, months: [{ id, month }] });
  }
}
---

<MarketingLayout
  title="What's New in Teak"
  description="A month-by-month look at what changed in Teak, where it helps, and what to do when an update affects you."
  canonical="https://teakvault.com/changelog"
  ogTitle="What's New in Teak"
  ogDescription="A month-by-month look at what changed in Teak, where it helps, and what to do when an update affects you."
  keywords="teak changelog, teak updates, what's new teak, teak release notes, teak new features"
>
  <main class="px-4 pt-14 pb-20">
    <section class="mx-auto flex max-w-xl flex-col items-center text-center">
      <h1 class="text-[clamp(2.125rem,4.4vw,3.125rem)] leading-[1.04] font-bold tracking-[-0.04em] text-balance">
        Changelog
      </h1>
      <p class="mt-4 max-w-md text-base leading-[1.6] text-balance text-muted-foreground">
        Monthly updates on what changed, where it helps, and what you may need to do.
      </p>
      <div class="mt-6 flex gap-2">
        <a class="inline-flex h-9 items-center gap-1.5 rounded-full border border-border bg-background px-4 font-medium text-[0.8125rem] transition-colors hover:bg-muted" href="https://x.com/praveenjuge" rel="noopener noreferrer" target="_blank">Follow on X</a>
        <a class="inline-flex h-9 items-center gap-1.5 rounded-full border border-border bg-background px-4 font-medium text-[0.8125rem] transition-colors hover:bg-muted" href="/changelog/rss.xml">
          <Icon name="rss" size={14} />
          RSS
        </a>
      </div>
    </section>

    <div class="mx-auto mt-20 grid max-w-5xl gap-12 lg:grid-cols-[10rem_minmax(0,1fr)] lg:gap-16">
      <nav aria-label="Months" class="hidden lg:block">
        <div class="sticky top-28 flex flex-col gap-5">
          {years.map(({ year, months }) => (
            <div>
              <p class="mb-2 text-xs font-semibold text-muted-foreground">{year}</p>
              <ul class="flex list-none flex-col gap-0.5 border-l border-border p-0">
                {months.map(({ id, month }) => (
                  <li>
                    <a class="month-link" data-month-link href={`#${id}`}>{month}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </nav>

      <div class="flex min-w-0 flex-col gap-20">
        {renderedEntries.map(({ entry, Content, href, id }) => (
          <article class="scroll-mt-28" data-blume-update id={id}>
            <header class="mb-8 border-b border-border pb-6">
              <h2 class="text-[1.75rem] leading-[1.15] font-bold tracking-[-0.03em]">
                <a class="hover:text-primary" href={href ?? `#${id}`}>{entry.data.title}</a>
              </h2>
              {entry.data.description && (
                <p class="mt-3 max-w-2xl text-[1.0625rem] leading-[1.6] text-pretty text-muted-foreground">
                  {entry.data.description}
                </p>
              )}
            </header>
            <ChangelogBody label={entry.data.title}>
              <Content />
            </ChangelogBody>
          </article>
        ))}
      </div>
    </div>
  </main>

<script>
  // Highlight the month in view in the sticky month list.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("a[data-month-link]")].map(
      (link) => [link.hash.slice(1), link]
    )
  );
  const observer = new IntersectionObserver(
    (records) => {
      for (const record of records) {
        if (!record.isIntersecting) {
          continue;
        }
        for (const [id, link] of links) {
          link.toggleAttribute("aria-current", id === record.target.id);
        }
      }
    },
    { rootMargin: "-25% 0px -70% 0px" }
  );
  for (const article of document.querySelectorAll("article[data-blume-update]")) {
    observer.observe(article);
  }
</script>

<style>
  /* End the hero's meadow before the first month so text never sits on it. */
  :global(.meadow-band-top) {
    height: 26rem;
  }


  .month-link {
    display: block;
    margin-left: -1px;
    padding: 0.25rem 0 0.25rem 0.875rem;
    border-left: 1px solid transparent;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .month-link:hover {
    color: var(--foreground);
  }

  .month-link[aria-current] {
    border-left-color: var(--foreground);
    color: var(--foreground);
    font-weight: 500;
  }
</style>
</MarketingLayout>
