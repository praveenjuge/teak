---
import DeviceShowcase from "../components/DeviceShowcase.astro";
import HomeFeatureShowcase from "../components/HomeFeatureShowcase.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { buildPageSchemas } from "../lib/jsonld";

const testimonials = [
  {
    quote:
      "Finally deleted my mess of 400 browser bookmarks. Everything I actually need lives in Teak now.",
  },
  {
    quote:
      "I save a Dribbble shot on my phone and it's waiting on my laptop when I sit down. That's the whole pitch and it just works.",
  },
  {
    quote:
      "The search is unreasonably good. I typed 'that orange gradient' and it actually found it.",
  },
  {
    quote:
      "Replaced three different apps with this. Notes, screenshots, links, all in one place that organizes itself.",
  },
  {
    quote:
      "I stopped losing references mid-project. Whatever I save shows up tagged and ready without me lifting a finger.",
  },
  {
    quote:
      "It's the first tool that actually fits how I work instead of forcing me into folders. I just dump things and trust I'll find them.",
  },
];

const faqs = [
  {
    question: "What can I save?",
    answer: "Images, links, notes, files, audio, and videos.",
  },
  {
    question: "Is my data private?",
    answer: "Yes. Your data is encrypted, and you can self-host.",
  },
  {
    question: "Where can I use Teak?",
    answer:
      "Teak works on the web, iPhone and iPad, macOS, Chrome and Safari extensions, and Raycast.",
  },
  {
    question: "How is this different from Pinterest?",
    answer: "Teak is for personal workflow, not social feeds or algorithms.",
  },
  {
    question: "What if I hit 200 cards?",
    answer: "Your cards stay safe. Upgrade or self-host to add more.",
  },
  {
    question: "Can I export and leave?",
    answer: "Yes. Export anytime with no lock-in.",
  },
];

const jsonLd = buildPageSchemas({
  title: "Never Lose That Perfect Design Again | Teak",
  description:
    "Save inspiration in 1 click, find it in 2 seconds. Never lose your best ideas again.",
  url: "https://teakvault.com",
  faqs,
});
---

<MarketingLayout
  title="Never Lose That Perfect Design Again"
  description="Save inspiration in 1 click, find it in 2 seconds. Never lose your best ideas again."
  canonical="https://teakvault.com"
  ogTitle="Never Lose That Perfect Design Again"
  ogDescription="Save inspiration in 1 click, find it in 2 seconds. Never lose your best ideas again."
  keywords="design bookmarking, visual inspiration, design organization, creative workflow, designer tools, bookmark manager"
  jsonLd={jsonLd}
>
  <section class="home-hero">
    <div class="hero-inner">
      <div class="hero-devices">
        <DeviceShowcase
          laptopAlt="Teak inspiration library on a MacBook"
          laptopSrc="/home-showcase/designer-mac.webp"
          variant="hero"
        />
      </div>

      <div class="hero-copy">
        <h1>Never lose that perfect design again.</h1>
        <p class="hero-description">
          Save inspiration in one click, find it in seconds, and keep every
          useful idea ready for the moment you need it.
        </p>
        <a class="hero-primary" href="https://app.teakvault.com/register" rel="noopener noreferrer" target="_blank">Start free</a>
      </div>
    </div>
  </section>

  <HomeFeatureShowcase />

  <!-- Testimonials Section -->
  <section class="testimonials">
    <div class="testimonials-inner">
      <div class="testimonials-header">
        <h2>
          Designers are quietly switching
        </h2>
        <p>
          Straight from people who save with Teak every day.
        </p>
      </div>

      <div class="testimonials-grid">
        {testimonials.map((testimonial) => (
          <figure class="testimonial-card">
            <blockquote>
              {testimonial.quote}
            </blockquote>
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </figure>
        ))}
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    margin-top: -5rem;
    padding: 6rem 1.5rem 4.5rem;
    color: var(--foreground);
  }

  .hero-inner {
    position: relative;
    max-width: 56rem;
    margin: 0 auto;
  }

  .hero-devices {
    width: min(100%, 42rem);
    margin: 0 auto;
  }

  .hero-copy {
    display: flex;
    max-width: 44rem;
    margin: 0 auto;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .hero-copy h1 {
    max-width: 36rem;
    margin: 2.75rem 0 0;
    font-size: clamp(2.125rem, 4.4vw, 3.125rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .hero-description {
    max-width: 36rem;
    margin: 1rem auto 1.5rem;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: balance;
  }

  .hero-primary {
    display: inline-flex;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    padding: 0 1.75rem;
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 160ms ease;
    white-space: nowrap;
  }

  .hero-primary:hover {
    background: color-mix(in oklch, var(--primary) 90%, transparent);
  }

  .testimonials {
    border-top: 1px solid var(--border);
    padding: 4.5rem 1.5rem 5rem;
  }

  .testimonials-inner {
    max-width: 62rem;
    margin: 0 auto;
  }

  .testimonials-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .testimonials-header h2 {
    margin: 0 0 0.625rem;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .testimonials-header p {
    margin: 0 auto;
    max-width: 32rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.6;
    text-wrap: balance;
  }

  .testimonials-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .testimonial-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.875rem;
    background: var(--card);
    margin: 0;
    padding: 1.25rem;
  }

  .testimonial-card blockquote {
    margin: 0;
    color: var(--card-foreground);
    font-size: 0.8125rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .testimonial-card svg {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--muted-foreground);
    opacity: 0.6;
  }

  @media (max-width: 860px) {
    .testimonials-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 720px) {
    .home-hero { padding: 5rem 1.25rem 4rem; }
    .hero-devices { width: min(100%, 30rem); }
    .hero-copy h1 { margin-top: 2rem; }
  }

  @media (max-width: 560px) {
    .testimonials { padding: 3.5rem 1.25rem 4rem; }
    .testimonials-grid { grid-template-columns: 1fr; }
  }
</style>
