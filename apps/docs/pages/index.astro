---
import DeviceShowcase from "../components/DeviceShowcase.astro";
import FeatureCard from "../components/FeatureCard.astro";
import HomeFeatureShowcase from "../components/HomeFeatureShowcase.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { buildPageSchemas } from "../lib/jsonld";

const testimonials = [
  {
    quote:
      "Finally deleted my mess of 400 browser bookmarks. Everything I actually need lives in Teak now.",
  },
  {
    quote:
      "I save a Dribbble shot on my phone and it's waiting on my laptop when I sit down. That's the whole pitch and it just works.",
  },
  {
    quote:
      "The search is unreasonably good. I typed 'that orange gradient' and it actually found it.",
  },
  {
    quote:
      "Replaced three different apps with this. Notes, screenshots, links, all in one place that organizes itself.",
  },
  {
    quote:
      "I stopped losing references mid-project. Whatever I save shows up tagged and ready without me lifting a finger.",
  },
  {
    quote:
      "It's the first tool that actually fits how I work instead of forcing me into folders. I just dump things and trust I'll find them.",
  },
];

const faqs = [
  {
    question: "What can I save?",
    answer: "Images, links, notes, files, audio, and videos.",
  },
  {
    question: "Is my data private?",
    answer: "Yes. Your data is encrypted, and you can self-host.",
  },
  {
    question: "Where can I use Teak?",
    answer:
      "Teak works on the web, iPhone and iPad, macOS, Chrome and Safari extensions, and Raycast.",
  },
  {
    question: "How is this different from Pinterest?",
    answer: "Teak is for personal workflow, not social feeds or algorithms.",
  },
  {
    question: "What if I hit 200 cards?",
    answer: "Your cards stay safe. Upgrade or self-host to add more.",
  },
  {
    question: "Can I export and leave?",
    answer: "Yes. Export anytime with no lock-in.",
  },
];

const jsonLd = buildPageSchemas({
  title: "Never Lose That Perfect Design Again | Teak",
  description:
    "Save inspiration in 1 click, find it in 2 seconds. Never lose your best ideas again.",
  url: "https://teakvault.com",
  faqs,
});
---

<MarketingLayout
  title="Never Lose That Perfect Design Again"
  description="Save inspiration in 1 click, find it in 2 seconds. Never lose your best ideas again."
  canonical="https://teakvault.com"
  ogTitle="Never Lose That Perfect Design Again"
  ogDescription="Save inspiration in 1 click, find it in 2 seconds. Never lose your best ideas again."
  keywords="design bookmarking, visual inspiration, design organization, creative workflow, designer tools, bookmark manager"
  jsonLd={jsonLd}
>
  <section class="home-hero">
    <div class="hero-inner">
      <div class="hero-devices">
        <DeviceShowcase
          laptopAlt="Teak inspiration library on a MacBook"
          laptopSrc="/home-showcase/designer-mac.webp"
          phoneAlt="Teak inspiration library on an iPhone"
          phoneSrc="/home-showcase/designer-iphone.webp"
          tabletAlt="Teak inspiration library on an iPad"
          tabletSrc="/home-showcase/designer-ipad.webp"
          variant="hero"
        />
      </div>

      <div class="hero-copy">
        <h1>Never lose that perfect design again.</h1>
        <p class="hero-description">
          Save inspiration in one click, find it in seconds, and keep every
          useful idea ready for the moment you need it.
        </p>
        <a class="hero-primary" href="https://app.teakvault.com/register" rel="noopener noreferrer" target="_blank">Start free</a>
      </div>
    </div>
  </section>

  <HomeFeatureShowcase />

  <!-- Testimonials Section -->
  <section class="border-border border-t bg-background py-16">
    <div class="container mx-auto max-w-4xl px-4">
      <div class="mb-16 text-center">
        <h2 class="mb-4 text-balance font-bold text-3xl">
          Designers are quietly switching
        </h2>
        <p class="mx-auto max-w-xl text-balance text-lg text-muted-foreground">
          Straight from people who save with Teak every day.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {testimonials.map((testimonial) => (
          <figure class="flex flex-col justify-between gap-4 rounded-2xl border border-border bg-card p-5">
            <blockquote class="text-balance text-card-foreground text-sm leading-relaxed">
              {testimonial.quote}
            </blockquote>
            <svg
              class="size-4 text-muted-foreground/60"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-4xl px-4">
      <div class="mb-12 text-center">
        <h2 class="mb-4 text-balance font-bold text-3xl">
          Still have questions?
        </h2>
        <p class="mx-auto max-w-xl text-balance text-lg text-muted-foreground">
          We've got answers. No corporate speak, promise.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {faqs.map((faq) => (
          <FeatureCard
            description={faq.answer}
            emojiAlt=""
            emojiSrc=""
            title={faq.question}
          />
        ))}
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    margin-top: -5rem;
    padding: 5.5rem 1rem 6.5rem;
    color: var(--foreground);
  }

  .hero-inner {
    position: relative;
    max-width: 88rem;
    margin: 0 auto;
  }

  .hero-devices {
    width: min(100%, 76rem);
    height: clamp(18rem, 30vw, 26rem);
    margin: 0 auto;
  }

  .hero-copy {
    display: flex;
    max-width: 68rem;
    margin: 0 auto;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .hero-copy h1 {
    max-width: 58rem;
    margin: 2.5rem 0 0;
    font-size: clamp(2.75rem, 5.6vw, 5.25rem);
    font-weight: 700;
    letter-spacing: -0.065em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .hero-description {
    max-width: 48rem;
    margin: 2rem auto 1.75rem;
    color: var(--muted-foreground);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.55;
    text-wrap: balance;
  }

  .hero-primary {
    display: inline-flex;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    padding: 0 1.5rem;
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 160ms ease;
    white-space: nowrap;
  }

  .hero-primary:hover {
    background: color-mix(in oklch, var(--primary) 90%, transparent);
  }

  @media (max-width: 720px) {
    .home-hero { padding: 4.5rem 1rem 5.5rem; }
    .hero-devices { height: clamp(12rem, 52vw, 16rem); }
    .hero-copy h1 { margin-top: 1.75rem; }
    .hero-description { margin-top: 1.5rem; }
  }
</style>
