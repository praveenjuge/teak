---
import DeviceShowcase from "../components/DeviceShowcase.astro";
import HomeFeatureShowcase from "../components/HomeFeatureShowcase.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { buildPageSchemas } from "../lib/jsonld";

const testimonials = [
  {
    quote:
      "Finally deleted my mess of 400 browser bookmarks. Everything I actually need lives in Teak now.",
  },
  {
    quote:
      "I save a Dribbble shot on my phone and it's waiting on my laptop when I sit down. That's the whole pitch and it just works.",
  },
  {
    quote:
      "The search is unreasonably good. I typed 'that orange gradient' and it actually found it.",
  },
  {
    quote:
      "Replaced three different apps with this. Notes, screenshots, links, all in one place that organizes itself.",
  },
  {
    quote:
      "I stopped losing references mid-project. Whatever I save shows up tagged and ready without me lifting a finger.",
  },
  {
    quote:
      "It's the first tool that actually fits how I work instead of forcing me into folders. I just dump things and trust I'll find them.",
  },
];

const faqs = [
  {
    question: "What can I save?",
    answer: "Images, links, notes, files, audio, and videos.",
  },
  {
    question: "Is my data private?",
    answer: "Yes. Your data is encrypted, and you can self-host.",
  },
  {
    question: "Where can I use Teak?",
    answer:
      "Teak works on the web, iPhone and iPad, macOS, Chrome and Safari extensions, and Raycast.",
  },
  {
    question: "How is this different from Pinterest?",
    answer: "Teak is for personal workflow, not social feeds or algorithms.",
  },
  {
    question: "What if I hit 200 cards?",
    answer: "Your cards stay safe. Upgrade or self-host to add more.",
  },
  {
    question: "Can I export and leave?",
    answer: "Yes. Export anytime with no lock-in.",
  },
];

const jsonLd = buildPageSchemas({
  title: "Never Lose That Perfect Design Again | Teak",
  description:
    "Save inspiration in 1 click, find it in 2 seconds. Never lose your best ideas again.",
  url: "https://teakvault.com",
  faqs,
});
---

<MarketingLayout
  title="Never Lose That Perfect Design Again"
  description="Save inspiration in 1 click, find it in 2 seconds. Never lose your best ideas again."
  canonical="https://teakvault.com"
  ogTitle="Never Lose That Perfect Design Again"
  ogDescription="Save inspiration in 1 click, find it in 2 seconds. Never lose your best ideas again."
  keywords="design bookmarking, visual inspiration, design organization, creative workflow, designer tools, bookmark manager"
  jsonLd={jsonLd}
>
  <section class="relative -mt-20 overflow-hidden px-6 pt-24 pb-18 max-md:px-5 max-md:pt-20 max-md:pb-16">
    <div class="relative mx-auto max-w-4xl">
      <div class="mx-auto w-full max-w-xl max-md:max-w-[26rem]">
        <DeviceShowcase
          laptopAlt="Teak inspiration library on a MacBook"
          laptopSrc="/home-showcase/designer-mac.webp"
          variant="hero"
        />
      </div>

      <div class="mx-auto flex max-w-[44rem] flex-col items-center text-center">
        <h1 class="mt-11 max-w-xl text-[clamp(2.125rem,4.4vw,3.125rem)] leading-[1.04] font-bold tracking-[-0.04em] text-balance max-md:mt-8">Never lose that perfect design again.</h1>
        <p class="mx-auto mt-4 mb-6 max-w-xl text-base leading-[1.6] text-balance text-muted-foreground">
          Save inspiration in one click, find it in seconds, and keep every
          useful idea ready for the moment you need it.
        </p>
        <a class="inline-flex h-10 items-center justify-center rounded-full bg-primary px-7 text-sm font-medium whitespace-nowrap text-primary-foreground no-underline transition-colors hover:bg-primary/90" href="https://app.teakvault.com/register" rel="noopener noreferrer" target="_blank">Start free</a>
      </div>
    </div>
  </section>

  <HomeFeatureShowcase />

  <!-- Testimonials Section -->
  <section class="border-t border-border px-6 pt-18 pb-20 max-md:px-5 max-md:pt-14 max-md:pb-16">
    <div class="mx-auto max-w-[62rem]">
      <div class="mb-10 text-center">
        <h2 class="mb-2.5 text-[1.375rem] leading-[1.2] font-bold tracking-[-0.025em] text-balance">
          Designers are quietly switching
        </h2>
        <p class="mx-auto max-w-lg text-[0.9375rem] leading-[1.6] text-balance text-muted-foreground">
          Straight from people who save with Teak every day.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 min-[561px]:grid-cols-2 min-[861px]:grid-cols-3">
        {testimonials.map((testimonial) => (
          <figure class="m-0 flex flex-col justify-between gap-5 rounded-[0.875rem] border border-border bg-card p-5">
            <blockquote class="m-0 text-[0.8125rem] leading-[1.65] text-pretty text-card-foreground">
              {testimonial.quote}
            </blockquote>
            <svg
              class="size-3.5 text-muted-foreground opacity-60"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </figure>
        ))}
      </div>
    </div>
  </section>
</MarketingLayout>
