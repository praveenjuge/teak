---
import HomeAppDemo from "../components/HomeAppDemo.astro";
import HomeAudiences from "../components/HomeAudiences.astro";
import HomeFeatureShowcase from "../components/HomeFeatureShowcase.astro";
import HomeTestimonials from "../components/HomeTestimonials.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { SIGN_UP_URL } from "../lib/app-entry";
import { buildPageSchemas } from "../lib/jsonld";

const faqs = [
  {
    question: "What can I save?",
    answer: "Images, links, notes, files, audio, and videos.",
  },
  {
    question: "Is my data private?",
    answer: "Yes. Your data is encrypted, and you can self-host.",
  },
  {
    question: "Where can I use Teak?",
    answer:
      "Teak works on the web, iPhone, iPad and Mac, Chrome and Safari extensions, and Raycast.",
  },
  {
    question: "How is this different from Pinterest?",
    answer: "Teak is for personal workflow, not social feeds or algorithms.",
  },
  {
    question: "What if I hit 200 cards?",
    answer: "Your cards stay safe. Upgrade or self-host to add more.",
  },
  {
    question: "Can I export and leave?",
    answer: "Yes. Export anytime with no lock-in.",
  },
];

const jsonLd = buildPageSchemas({
  title: "Never Lose That Perfect Design Again | Teak",
  description:
    "Save inspiration in 1 click, find it in 2 seconds. Never lose your best ideas again.",
  url: "https://teakvault.com",
  faqs,
});
---

<MarketingLayout
  title="Never Lose That Perfect Design Again"
  description="Save inspiration in 1 click, find it in 2 seconds. Never lose your best ideas again."
  canonical="https://teakvault.com"
  ogTitle="Never Lose That Perfect Design Again"
  ogDescription="Save inspiration in 1 click, find it in 2 seconds. Never lose your best ideas again."
  keywords="design bookmarking, visual inspiration, design organization, creative workflow, designer tools, bookmark manager"
  jsonLd={jsonLd}
>
  <section class="relative -mt-20 overflow-hidden px-6 pt-30 pb-18 max-md:px-4 max-md:pt-26 max-md:pb-16">
    <div class="mx-auto flex max-w-[44rem] flex-col items-center text-center">
      <h1 class="max-w-xl text-[clamp(2.125rem,4.4vw,3.125rem)] leading-[1.04] font-bold tracking-[-0.04em] text-balance">Never lose that perfect design again.</h1>
      <p class="mx-auto mt-4 mb-6 max-w-xl text-base leading-[1.6] text-balance text-muted-foreground">
        Save inspiration in one click, find it in seconds, and keep every
        useful idea ready for the moment you need it.
      </p>
      <a class="inline-flex h-10 items-center justify-center rounded-full bg-primary px-7 text-sm font-medium whitespace-nowrap text-primary-foreground no-underline transition-colors hover:bg-primary/90" data-app-entry href={SIGN_UP_URL} rel="noopener noreferrer" target="_blank">Start Saving →</a>
    </div>

    <div class="mx-auto mt-14 max-w-[78rem] max-md:mt-10">
      <HomeAppDemo />
    </div>
  </section>

  <HomeFeatureShowcase />

  <HomeAudiences />

  <HomeTestimonials />
</MarketingLayout>
