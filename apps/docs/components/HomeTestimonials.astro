---
import { testimonials } from "../lib/testimonials";

const [lead, ...rest] = testimonials;
---

<section aria-labelledby="testimonials-title" class="border-t border-border px-6 pt-18 pb-20 max-md:px-5 max-md:pt-14 max-md:pb-16">
  <div class="mx-auto max-w-5xl">
    <div class="mb-10 text-center">
      <h2 class="mb-2.5 text-[1.375rem] leading-[1.2] font-bold tracking-[-0.025em] text-balance" id="testimonials-title">
        Why people switch to Teak
      </h2>
      <p class="mx-auto max-w-lg text-[0.9375rem] leading-[1.6] text-balance text-muted-foreground">
        Straight from people who save with Teak every day.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 min-[561px]:grid-cols-2 min-[861px]:grid-cols-3">
      <figure class="m-0 flex flex-col justify-between gap-5 rounded-xl border border-border bg-card p-8 min-[561px]:col-span-2 min-[861px]:row-span-2">
        <span aria-hidden="true" class="text-[4rem] leading-[0.6] font-bold text-primary">“</span>
        <blockquote class="m-0 text-[clamp(1.25rem,2.2vw,1.625rem)] leading-[1.35] font-semibold tracking-[-0.02em] text-balance">
          {lead.quote}
        </blockquote>
      </figure>
      {rest.map((testimonial) => (
        <figure class="m-0 rounded-xl border border-border bg-card p-6 min-[561px]:max-[860px]:last:col-span-2">
          <blockquote class="m-0 text-[0.875rem] leading-[1.65] text-pretty text-card-foreground">
            {testimonial.quote}
          </blockquote>
        </figure>
      ))}
    </div>
  </div>
</section>

