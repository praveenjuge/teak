---
const features = [
  {
    eyebrow: "Eight card types, one library",
    title: "Save anything worth remembering.",
    description:
      "Keep a thought, a link, a screenshot, a video, a recording, a document, a palette, or a quote without forcing it into the wrong shape.",
    imageAlt:
      "Teak library with design links, photos, palettes, quotes, notes, a voice memo, a video, and a PDF",
    imageHeight: 982,
    imageSrc: "/home-showcase/library-mac.webp",
    imageWidth: 1512,
    visual: "save",
  },
  {
    eyebrow: "Capture everywhere",
    title: "Keep the idea without leaving your flow.",
    description:
      "Save from the web, the iOS share sheet, Teak for Mac, Chrome and Safari extensions, or Raycast. Everything meets in one synced library.",
    visual: "capture",
  },
  {
    eyebrow: "Search the way you remember",
    title: "Start with the detail still in your head.",
    description:
      "Search keywords, card types, tags, dates, color names, hex values, or visual styles. Teak turns the clues into filters for you.",
    imageAlt:
      "Teak search for typography showing a font site, type notes, and a typewriter photo",
    imageHeight: 627,
    imageSrc: "/home-showcase/search-mac.webp",
    imageWidth: 1512,
    visual: "search",
  },
  {
    eyebrow: "Automatic organization",
    title: "Save it now. Let Teak do the filing.",
    description:
      "New cards gain AI tags and summaries, richer link previews, extracted palettes, and audio transcripts in the background.",
    imageAlt:
      "Teak image card with an AI summary, AI tags, and extracted colors",
    imageHeight: 732,
    imageSrc: "/home-showcase/organize-mac.webp",
    imageWidth: 1200,
    visual: "organize",
  },
  {
    eyebrow: "Portable by design",
    title: "Bring your library in. Take it with you.",
    description:
      "Import browser bookmarks, a Raindrop CSV, or a Teak archive, skipping links you already have. Export everything, with original files, as a ZIP.",
    imageAlt:
      "Teak import dialog after a bookmarks import with 6 cards created and 2 skipped",
    imageHeight: 1028,
    imageSrc: "/home-showcase/import-mac.webp",
    imageWidth: 920,
    visual: "portable",
  },
  {
    eyebrow: "Built for your tools and agents",
    title: "Your library, beyond the app.",
    description:
      "Use Teak through its REST API, remote MCP endpoint, CLI, Raycast AI tools, the ChatGPT connector, or the public agent skill.",
    imageAlt:
      "Teak security settings showing signed-in devices and the connected Teak CLI",
    imageHeight: 718,
    imageSrc: "/home-showcase/connected-apps-mac.webp",
    imageWidth: 920,
    visual: "agents",
  },
] as const;
---

<section class="px-6 pt-10 pb-20 max-md:px-4 max-md:pt-6 max-md:pb-16" aria-labelledby="features-title">
  <div class="mx-auto max-w-[72rem]">
    <div class="mx-auto mb-10 max-w-xl text-center max-md:mb-8">
      <p class="mb-3 text-[0.6875rem] leading-[1.4] font-semibold tracking-[0.08em] text-muted-foreground uppercase">Everything in one place</p>
      <h2 class="mb-3 text-[clamp(1.75rem,3.4vw,2.375rem)] leading-[1.08] font-bold tracking-[-0.035em] text-balance" id="features-title">Save it once. Find it in seconds.</h2>
      <p class="text-[0.9375rem] leading-[1.6] text-balance text-muted-foreground">
        A calm library for every reference, with search that remembers the details for you.
      </p>
    </div>

    <ul class="grid list-none grid-cols-1 gap-4 p-0 min-[720px]:grid-cols-2 min-[1024px]:grid-cols-6">
      {features.map((feature) => (
        <li class:list={["feature-card", `feature-${feature.visual}`]}>
          <figure class="feature-visual meadow">
            {feature.visual === "capture" ? (
              <div class="capture-scene">
                <img alt="Teak in the iPhone share sheet while saving a museum page from Safari" class="capture-phone" decoding="async" height="995" loading="lazy" src="/home-showcase/share-iphone.webp" width="480" />
                <img alt="Teak for Mac Quick Capture panel with a note about lobby signage" class="capture-panel" decoding="async" height="390" loading="lazy" src="/home-showcase/quick-capture-mac.webp" width="780" />
              </div>
            ) : (
              <img alt={feature.imageAlt} decoding="async" height={feature.imageHeight} loading="lazy" src={feature.imageSrc} width={feature.imageWidth} />
            )}
          </figure>
          <div class="p-6 max-md:p-5">
            <p class="mb-2 text-[0.6875rem] leading-[1.4] font-semibold tracking-[0.08em] text-muted-foreground uppercase">{feature.eyebrow}</p>
            <h3 class="mb-2 text-lg leading-[1.2] font-bold tracking-[-0.02em] text-balance">{feature.title}</h3>
            <p class="text-sm leading-[1.6] text-pretty text-muted-foreground">{feature.description}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex justify-center max-md:mt-8">
      <a class="inline-flex h-10 items-center justify-center gap-2 rounded-full bg-primary px-7 text-sm font-medium whitespace-nowrap text-primary-foreground no-underline transition-colors hover:bg-primary/90" href="https://app.teakvault.com/register" rel="noopener noreferrer" target="_blank">Start Saving →</a>
    </div>
  </div>
</section>

<style>
  .feature-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    background: var(--card);
  }

  .feature-visual {
    position: relative;
    height: 17rem;
    margin: 0;
    overflow: hidden;
    isolation: isolate;
  }

  /* Screenshots peek in from the edge, like the app window in the store images. */
  .feature-visual > img {
    position: absolute;
    display: block;
    max-width: none;
    height: auto;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 0.875rem;
    box-shadow: 0 18px 40px -16px rgb(25 40 28 / 0.45);
  }

  .feature-save > .feature-visual > img,
  .feature-search > .feature-visual > img {
    top: 2.25rem;
    left: 2.25rem;
  }

  .feature-save > .feature-visual > img { width: 52rem; }
  .feature-search > .feature-visual > img { width: 46rem; }

  .feature-organize > .feature-visual > img,
  .feature-portable > .feature-visual > img,
  .feature-agents > .feature-visual > img {
    top: 2.25rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .feature-organize > .feature-visual > img { width: 88%; }
  .feature-portable > .feature-visual > img { width: 66%; }
  .feature-agents > .feature-visual > img { width: 78%; }

  /* Two real capture surfaces: the iPhone share sheet and Mac Quick Capture. */
  .capture-scene {
    position: absolute;
    inset: 0;
  }

  /* The phone sits on the right at the card's height, so its share sheet with
     Teak stays in view; the Mac panel floats over the page above it. */
  .capture-phone {
    position: absolute;
    right: 9%;
    bottom: 1.25rem;
    width: auto;
    height: calc(100% - 2.5rem);
    filter: drop-shadow(0 18px 28px rgb(25 40 28 / 0.4));
  }

  .capture-panel {
    position: absolute;
    top: 2.25rem;
    left: 7%;
    width: min(14.5rem, 60%);
    height: auto;
    border-radius: 0.75rem;
    box-shadow:
      0 0 0 1px rgb(25 40 28 / 0.08),
      0 22px 44px -14px rgb(25 40 28 / 0.5);
  }

  @media (min-width: 720px) {
    .feature-save,
    .feature-agents {
      grid-column: span 2;
    }
  }

  @media (min-width: 1024px) {
    .feature-save { grid-column: span 4; }
    .feature-capture { grid-column: span 2; }
    .feature-search,
    .feature-organize,
    .feature-portable,
    .feature-agents {
      grid-column: span 3;
    }
    .feature-save > .feature-visual,
    .feature-capture > .feature-visual {
      height: 22rem;
    }
  }

  @media (max-width: 520px) {
    .feature-visual { height: 15rem; }
    .feature-save > .feature-visual > img,
    .feature-search > .feature-visual > img {
      top: 1.5rem;
      left: 1.5rem;
    }
    .feature-save > .feature-visual > img { width: 40rem; }
    .feature-search > .feature-visual > img { width: 36rem; }
    .feature-organize > .feature-visual > img { width: 94%; }
    .feature-portable > .feature-visual > img { width: 80%; }
    .feature-agents > .feature-visual > img { width: 90%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .feature-visual > img { transition: scale 500ms cubic-bezier(0.2, 0.8, 0.2, 1); }
    .feature-card:hover .feature-visual > img { scale: 1.02; }
  }
</style>
