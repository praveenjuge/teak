---
import Badge from "blume/components/content/Badge.astro";
import Icon from "blume/components/Icon.astro";

interface Props {
  ctaHref: string;
  ctaPrimary?: boolean;
  ctaText: string;
  description: string;
  emojiAlt: string;
  emojiSrc: string;
  features: readonly string[];
  name: string;
  popular?: boolean;
  price:
    | string
    | {
        monthly: { amount: string; period: string };
        yearly: { amount: string; period: string };
      };
}

const {
  name: _name,
  description,
  emojiAlt,
  emojiSrc,
  features,
  price,
  ctaText,
  ctaHref,
  ctaPrimary = false,
  popular = false,
} = Astro.props;
const isFixedPrice = typeof price === "string";
---

<div class:list={[
  "relative rounded-2xl border bg-card p-8",
  popular ? "border-primary ring-1 ring-primary" : "border-border",
]}>
  {popular && (
    <div class="absolute -top-3 left-1/2 -translate-x-1/2 transform">
      <Badge
        class="!border-transparent !bg-primary !text-primary-foreground px-2.5 py-0.5 font-semibold"
        size="md"
      >
        Pro - Most Popular
      </Badge>
    </div>
  )}

  <div class="text-center">
    <img
      alt={emojiAlt}
      class="mx-auto mb-3 size-14 object-contain"
      height="56"
      src={emojiSrc}
      width="56"
    />

    {isFixedPrice ? (
      <div class="mb-4">
        <span class="font-bold text-4xl tracking-tight">{price}</span>
      </div>
    ) : (
      <>
        <div class="mb-4" data-price-monthly>
          <span class="font-bold text-4xl tracking-tight">{price.monthly.amount}</span>
          <span class="text-muted-foreground">/{price.monthly.period}</span>
        </div>
        <div class="mb-4 hidden" data-price-yearly>
          <span class="font-bold text-4xl tracking-tight">{price.yearly.amount}</span>
          <span class="text-muted-foreground">/{price.yearly.period}</span>
        </div>
      </>
    )}

    <p class="mb-6 text-muted-foreground">{description}</p>
  </div>

  <ul class="mb-8 space-y-3">
    {features.map((feature) => (
      <li class="flex items-start gap-3">
        <Icon class="mt-1 text-primary" name="check" size={16} />
        <span>{feature}</span>
      </li>
    ))}
  </ul>

  <a
    class:list={[
      "inline-flex w-full items-center justify-center rounded-full font-medium text-sm h-10 px-4",
      ctaPrimary
        ? "bg-primary text-primary-foreground hover:bg-primary/90"
        : "border bg-background hover:bg-accent hover:text-accent-foreground",
    ]}
    href={ctaHref}
    rel="noopener noreferrer"
    target="_blank"
  >
    {ctaText}
  </a>
</div>
