---
import Icon from "blume/components/Icon.astro";

interface Price {
  amount: string;
  note: string;
  period: string;
}

interface Props {
  ctaHref: string;
  ctaPrimary?: boolean;
  ctaText: string;
  emojiAlt: string;
  emojiSrc: string;
  features: readonly string[];
  name: string;
  popular?: boolean;
  price: string | { monthly: Price; yearly: Price };
  /** Small print under a fixed price. */
  priceNote?: string;
}

const {
  name,
  emojiAlt,
  emojiSrc,
  features,
  price,
  priceNote,
  ctaText,
  ctaHref,
  ctaPrimary = false,
  popular = false,
} = Astro.props;
const isFixedPrice = typeof price === "string";
---

<div class:list={[
  "pricing-card flex flex-col rounded-2xl border bg-card p-8",
  popular ? "border-primary ring-1 ring-primary" : "border-border",
]}>
  <div class="mb-6 text-center">
    <img
      alt={emojiAlt}
      class="pricing-emoji mx-auto mb-3 size-12 object-contain"
      height="48"
      src={emojiSrc}
      width="48"
    />
    <h2 class="mb-3 font-semibold text-lg">{name}</h2>

    {isFixedPrice ? (
      <div>
        <span class="font-bold text-4xl tracking-tight">{price}</span>
        {priceNote && <p class="mt-1 text-muted-foreground text-sm">{priceNote}</p>}
      </div>
    ) : (
      (["monthly", "yearly"] as const).map((period) => {
        const p = price[period];
        return (
          <div
            class:list={[period === "monthly" && "hidden"]}
            data-price-monthly={period === "monthly" ? "" : undefined}
            data-price-yearly={period === "yearly" ? "" : undefined}
          >
            <span class="font-bold text-4xl tracking-tight">{p.amount}</span>
            <span class="text-muted-foreground">/{p.period}</span>
            <p class="mt-1 text-muted-foreground text-sm">{p.note}</p>
          </div>
        );
      })
    )}
  </div>

  <ul class="mb-8 flex-1 space-y-3 border-border border-t pt-6 text-sm">
    {features.map((feature) => (
      <li class="flex items-start gap-3">
        <Icon class="mt-0.5 shrink-0 text-primary" name="check" size={16} />
        <span>{feature}</span>
      </li>
    ))}
  </ul>

  <a
    class:list={[
      "inline-flex w-full items-center justify-center rounded-full font-medium text-sm h-10 px-4 transition-colors",
      ctaPrimary
        ? "bg-primary text-primary-foreground hover:bg-primary/90"
        : "border bg-background hover:bg-accent hover:text-accent-foreground",
    ]}
    href={ctaHref}
    rel="noopener noreferrer"
    target="_blank"
  >
    {ctaText}
  </a>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .pricing-emoji {
      transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .pricing-card:hover .pricing-emoji {
      transform: translateY(-2px) scale(1.05);
    }

    :global(.price-enter) {
      animation: price-enter 260ms ease-out;
    }
  }

  @keyframes price-enter {
    from {
      opacity: 0;
      translate: 0 0.375rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
