---
import Icon from "blume/components/Icon.astro";
import {
  APP_STORE_URL,
  CHROME_STORE_URL,
  FIREFOX_ADDONS_URL,
  MAC_APP_STORE_URL,
  RAYCAST_STORE_URL,
} from "../lib/app-links";

const WEB_APP_URL = "https://app.teakvault.com";
const API_DOCS_URL = "/docs/api";
const MCP_DOCS_URL = "/docs/mcp";
const CLI_DOCS_URL = "/docs/cli";
const SKILLS_URL = "https://skills.sh/praveenjuge/teak";
const RAYCAST_INSTALL_BUTTON_URL =
  "https://www.raycast.com/praveenjuge/teak-raycast/install_button@2x.png?v=1.1";

type Platform = "ios" | "mac" | "android" | "web" | "chrome" | "firefox";

interface Badge {
  alt: string;
  height: number;
  src: string;
  width: number;
}

interface AppCard {
  badge?: Badge;
  comingSoon?: boolean;
  copy: string;
  href?: string;
  iconAlt: string;
  iconClass?: string;
  iconSrc: string;
  label?: string;
  name: string;
  platform?: Platform;
}

interface DeveloperCard {
  copy: string;
  docsLabel: string;
  href: string;
  logo: { alt: string; class?: string; src: string };
  meta: string;
  name: string;
  shell: boolean;
  snippet: string;
}

const APP_STORE_BADGE = {
  src: "/badges/app-store.svg",
  width: 140,
  height: 47,
};

const deviceCards: AppCard[] = [
  {
    platform: "ios",
    name: "iPhone & iPad",
    copy: "Save photos, voice notes, and links from the share sheet. They show up on every other device in seconds.",
    iconAlt: "Apple icon",
    iconClass: "dark:invert",
    iconSrc: "/platform-icons/apple.svg",
    href: APP_STORE_URL,
    badge: { ...APP_STORE_BADGE, alt: "Download on the App Store" },
  },
  {
    platform: "mac",
    name: "Mac",
    copy: "A native Mac library with Quick Capture for notes, quotes, files, and audio.",
    iconAlt: "Apple icon",
    iconClass: "dark:invert",
    iconSrc: "/platform-icons/apple.svg",
    href: MAC_APP_STORE_URL,
    badge: {
      ...APP_STORE_BADGE,
      alt: "Download Teak on the Mac App Store",
    },
  },
  {
    platform: "android",
    comingSoon: true,
    name: "Android",
    copy: "Share into Teak from any app, or select text and choose Save to Teak. Coming soon to Google Play.",
    iconAlt: "Android icon",
    iconSrc: "/platform-icons/android.svg",
  },
  {
    name: "Raycast",
    copy: "Save your clipboard, search your cards, and jump to favorites without leaving the keyboard.",
    iconAlt: "Raycast icon",
    iconSrc: "/platform-icons/raycast.svg",
    href: RAYCAST_STORE_URL,
    badge: {
      src: RAYCAST_INSTALL_BUTTON_URL,
      alt: "Install the Teak Raycast extension",
      width: 256,
      height: 64,
    },
  },
];

const browserCards: AppCard[] = [
  {
    platform: "web",
    name: "Web App",
    copy: "Search your whole library, write notes in Markdown, and drop in files from any desktop browser.",
    iconAlt: "Teak icon",
    iconSrc: "/icon.png",
    href: WEB_APP_URL,
    label: "Open Web App",
  },
  {
    platform: "chrome",
    name: "Chrome Extension",
    copy: "Save tabs, screenshots, or selected text in a click. Teak grabs the metadata for you.",
    iconAlt: "Google Chrome icon",
    iconSrc: "/platform-icons/chrome.svg",
    href: CHROME_STORE_URL,
    badge: {
      src: "/badges/chrome-web-store-badge.svg",
      alt: "Available in the Chrome Web Store",
      width: 160,
      height: 45,
    },
  },
  {
    platform: "firefox",
    name: "Firefox Extension",
    copy: "Everything the Chrome extension does, in Firefox: save pages, images, and text, and search Teak from the address bar.",
    iconAlt: "Firefox icon",
    iconSrc: "/platform-icons/firefox.svg",
    href: FIREFOX_ADDONS_URL,
    badge: {
      src: "/badges/firefox-addons-badge.svg",
      alt: "Get the add-on for Firefox",
      width: 129,
      height: 45,
    },
  },
  {
    name: "Safari Extension",
    copy: "Save the page you're on from Safari's toolbar. It comes with the Mac app, so there's nothing else to install.",
    iconAlt: "Safari icon",
    iconSrc: "/platform-icons/safari.svg",
    href: MAC_APP_STORE_URL,
    badge: {
      ...APP_STORE_BADGE,
      alt: "Get the Safari extension with Teak on the Mac App Store",
    },
  },
];

const developerCards: DeveloperCard[] = [
  {
    name: "MCP",
    logo: {
      src: "/platform-icons/mcp.svg",
      alt: "Model Context Protocol logo",
      class: "dark:invert",
    },
    copy: "Let AI assistants search, save, and manage your cards over the remote MCP server.",
    meta: "Remote server",
    shell: false,
    snippet: "https://teakvault.com/mcp",
    href: MCP_DOCS_URL,
    docsLabel: "Docs",
  },
  {
    name: "REST API",
    logo: { src: "/platform-icons/openapi.svg", alt: "OpenAPI logo" },
    copy: "Create, search, and update cards from your own tools with an API key.",
    meta: "HTTPS with an API key",
    shell: true,
    snippet:
      'curl https://teakvault.com/api/v1/cards -H "Authorization: Bearer $TEAK_API_KEY"',
    href: API_DOCS_URL,
    docsLabel: "Docs",
  },
  {
    name: "Command Line",
    logo: { src: "/platform-icons/npm.svg", alt: "npm logo" },
    copy: "Save, search, favorite, and manage cards from any terminal.",
    meta: "npm package",
    shell: true,
    snippet: "npm i -g teak-cli",
    href: CLI_DOCS_URL,
    docsLabel: "Docs",
  },
  {
    name: "Agent Skill",
    logo: {
      src: "/platform-icons/skills-sh.svg",
      alt: "skills.sh logo",
      class: "dark:invert",
    },
    copy: "Teach coding agents to use Teak through the CLI, API, MCP, and SDK.",
    meta: "skills.sh",
    shell: true,
    snippet: "npx skills add praveenjuge/teak --skill teak",
    href: SKILLS_URL,
    docsLabel: "View",
  },
];

const groups = [
  {
    id: "devices",
    title: "On your devices",
    description:
      "Native apps that capture from the share sheet, the menu bar, your launcher, and everywhere in between.",
    cards: deviceCards,
  },
  {
    id: "browser",
    title: "In your browser",
    description:
      "Open your library anywhere, and save the page you're on without switching tabs.",
    cards: browserCards,
  },
];

const isExternal = (href?: string) => href?.startsWith("http") ?? false;
---

<div class="mx-auto mt-16 flex w-full max-w-5xl flex-col gap-14" data-apps-grid>
  {groups.map((group) => (
    <section aria-labelledby={`apps-${group.id}`}>
      <div class="mb-5 max-w-xl">
        <h2 class="text-2xl leading-tight font-bold tracking-[-0.025em]" id={`apps-${group.id}`}>{group.title}</h2>
        <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-pretty text-muted-foreground">{group.description}</p>
      </div>
      <ul class="grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2">
        {group.cards.map((card) => (
          <li class:list={["app-card group", { "app-card-static": !card.href }]} data-platform={card.platform}>
            <div class="flex items-start justify-between gap-3">
              <span class="app-icon">
                <img alt={card.iconAlt} class:list={["size-7 object-contain", card.iconClass]} height="28" src={card.iconSrc} width="28" />
              </span>
              <span class="flex flex-wrap justify-end gap-1.5">
                <span class="current-pill" data-current-pill hidden>For your device</span>
                {card.comingSoon && <span class="soon-pill">Coming soon</span>}
              </span>
            </div>
            <h3 class="mt-4 text-lg leading-tight font-semibold tracking-[-0.01em]">
              {card.href ? (
                <a
                  class="app-card-link"
                  href={card.href}
                  rel={isExternal(card.href) ? "noopener noreferrer" : undefined}
                  target={isExternal(card.href) ? "_blank" : undefined}
                >
                  {card.name}
                </a>
              ) : (
                card.name
              )}
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-pretty text-muted-foreground">{card.copy}</p>
            <div class="mt-auto flex items-center gap-3 pt-5">
              {card.badge && (
                <img alt={card.badge.alt} class="h-10 w-auto object-contain" height={card.badge.height} src={card.badge.src} width={card.badge.width} />
              )}
              {card.label && (
                <span class="inline-flex h-10 items-center justify-center rounded-full bg-primary px-5 text-sm font-medium text-primary-foreground transition-opacity group-hover:opacity-90">
                  {card.label}
                </span>
              )}
              {card.comingSoon && (
                <img alt="Google Play, coming soon" class="h-10 w-auto opacity-35 grayscale" height="40" src="/badges/google-play.svg" width="135" />
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section aria-labelledby="apps-builders">
    <div class="mb-5 max-w-xl">
      <h2 class="text-2xl leading-tight font-bold tracking-[-0.025em]" id="apps-builders">For builders and agents</h2>
      <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-pretty text-muted-foreground">Wire your library into your own tools. Copy the first line, and the docs cover the rest.</p>
    </div>
    <ul class="dev-grid grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2">
      {developerCards.map((card) => (
        <li class="app-card dev-card group">
          <div class="flex items-center gap-3">
            <span class="app-icon dev-icon">
              <img alt={card.logo.alt} class:list={["size-6 object-contain", card.logo.class]} height="24" src={card.logo.src} width="24" />
            </span>
            <div class="min-w-0 flex-1">
              <h3 class="text-base leading-tight font-semibold tracking-[-0.01em]">
                <a
                  class="app-card-link"
                  href={card.href}
                  rel={isExternal(card.href) ? "noopener noreferrer" : undefined}
                  target={isExternal(card.href) ? "_blank" : undefined}
                >
                  {card.name}
                </a>
              </h3>
              <p class="mt-0.5 text-xs text-muted-foreground">{card.meta}</p>
            </div>
            <span class="docs-link" aria-hidden="true">
              {card.docsLabel}
              <Icon name="arrow-up-right" size={14} />
            </span>
          </div>
          <p class="text-sm leading-relaxed text-pretty text-muted-foreground">{card.copy}</p>
          <div class="snippet">
            <code class="snippet-code">
              {card.shell && <span class="snippet-prompt" aria-hidden="true">$</span>}
              {card.snippet}
            </code>
            <button aria-label={`Copy ${card.name} snippet`} class="copy-button" data-copy={card.snippet} type="button">
              <span class="copy-idle"><Icon name="copy" size={15} /></span>
              <span class="copy-done" hidden><Icon name="check" size={15} /></span>
            </button>
          </div>
        </li>
      ))}
    </ul>
    <p class="sr-only" aria-live="polite" data-copy-status></p>
  </section>
</div>

<script>
  type Platform = "ios" | "mac" | "android" | "web" | "chrome" | "firefox";

  const detectPlatform = (): Platform => {
    const override = new URLSearchParams(location.search).get("platform");
    if (override && ["ios", "mac", "android", "web", "chrome", "firefox"].includes(override)) {
      return override as Platform;
    }
    const nav = navigator as Navigator & {
      userAgentData?: { brands?: { brand: string }[]; platform?: string };
    };
    const ua = navigator.userAgent;
    const platform = nav.userAgentData?.platform ?? navigator.platform;
    // iPadOS reports itself as a Mac, so touch support tells them apart.
    const isIOS =
      /iPhone|iPad|iPod/.test(ua) ||
      (/mac/i.test(platform) && navigator.maxTouchPoints > 1);
    if (isIOS) return "ios";
    if (/Android/i.test(ua)) return "android";
    if (/mac/i.test(platform)) return "mac";
    if (/Firefox\//.test(ua)) return "firefox";
    const isChromium = nav.userAgentData?.brands?.some(({ brand }) =>
      /Chromium|Google Chrome/.test(brand)
    );
    return isChromium ? "chrome" : "web";
  };

  for (const grid of document.querySelectorAll<HTMLElement>("[data-apps-grid]")) {
    const card = grid.querySelector<HTMLElement>(
      `[data-platform="${detectPlatform()}"]`
    );
    if (card) {
      card.dataset.current = "";
      // Move it in the DOM, not just visually, so focus order matches.
      card.parentElement?.prepend(card);
      card.querySelector<HTMLElement>("[data-current-pill]")?.removeAttribute("hidden");
    }

    const status = grid.querySelector<HTMLElement>("[data-copy-status]");
    for (const button of grid.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
        } catch {
          return;
        }
        const idle = button.querySelector<HTMLElement>(".copy-idle");
        const done = button.querySelector<HTMLElement>(".copy-done");
        idle?.setAttribute("hidden", "");
        done?.removeAttribute("hidden");
        if (status) status.textContent = "Copied to clipboard";
        setTimeout(() => {
          idle?.removeAttribute("hidden");
          done?.setAttribute("hidden", "");
          if (status) status.textContent = "";
        }, 1600);
      });
    }
  }
</script>

<style>
  .app-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    border-radius: 1.25rem;
    background: var(--card);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
    transition:
      translate 250ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 250ms ease,
      border-color 250ms ease;
  }

  .app-card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .app-card-link:focus-visible {
    outline: none;
  }

  .app-card:has(.app-card-link:focus-visible) {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .app-card:not(.app-card-static):hover {
    border-color: var(--border);
    box-shadow: 0 18px 36px -18px rgb(25 40 28 / 0.35);
  }

  @media (prefers-reduced-motion: no-preference) {
    .app-card:not(.app-card-static):hover { translate: 0 -3px; }
  }

  .current-pill,
  .soon-pill {
    display: inline-flex;
    align-items: center;
    height: 1.5rem;
    padding: 0 0.625rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .current-pill {
    background: color-mix(in oklab, var(--primary) 14%, transparent);
    color: var(--primary);
  }

  .soon-pill {
    background: color-mix(in oklab, #34a853 16%, transparent);
    color: #1e7a3a;
  }

  :is(.dark, [data-theme="dark"]) .soon-pill {
    color: #6fd08c;
  }

  .app-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    border-radius: 0.75rem;
    background: var(--background);
  }

  .dev-card {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 1rem;
  }

  .dev-icon {
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: 0.625rem;
  }

  .docs-link {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.25rem;
    align-self: flex-start;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    font-weight: 500;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .dev-card:hover .docs-link {
    background: var(--muted);
    color: var(--primary);
  }

  .snippet {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    align-self: end;
    gap: 0.25rem;
    min-width: 0;
    height: 2.75rem;
    padding: 0 0.375rem 0 0.875rem;
    border: 1px solid color-mix(in oklab, var(--border) 80%, transparent);
    border-radius: 0.75rem;
    background: color-mix(in oklab, var(--muted) 70%, var(--background));
  }

  .snippet-code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    padding-right: 1.5rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.8125rem;
    white-space: nowrap;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, black calc(100% - 2rem), transparent);
  }

  .snippet-prompt {
    margin-right: 0.5rem;
    color: var(--muted-foreground);
    user-select: none;
  }

  .copy-button {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    color: var(--muted-foreground);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .copy-button:hover {
    background: var(--background);
    color: var(--foreground);
  }

  .copy-done {
    color: #16a34a;
  }
</style>
