---
import Icon from "blume/components/Icon.astro";
import { AUDIENCE_PAGE_LIST } from "../lib/audience-pages";
import {
  DEMO_CARD_TYPES,
  type DemoCard,
  pickDemoColumns,
} from "../lib/home-demo-cards";

// Each card previews three of the cards its audience page shows, preferring
// ones with an image or palette so the strip reads at thumbnail size.
const THUMBS_PER_CARD = 3;

const isVisual = (card: DemoCard) =>
  Boolean(card.image) || (card.type === "palette" && Boolean(card.colors));

const audiences = AUDIENCE_PAGE_LIST.map((page) => {
  const cards = pickDemoColumns(
    page.demoCardIds,
    page.demoCardIds.length
  ).flat();
  return {
    page,
    thumbs: [
      ...cards.filter(isVisual),
      ...cards.filter((card) => !isVisual(card)),
    ].slice(0, THUMBS_PER_CARD),
  };
});
---

<section aria-labelledby="audiences-title" class="border-t border-border px-6 pt-18 pb-20 max-md:px-5 max-md:pt-14 max-md:pb-16">
  <div class="mx-auto max-w-5xl">
    <div class="mb-10 text-center">
      <p class="mb-3 text-[0.6875rem] leading-[1.4] font-semibold tracking-[0.08em] text-muted-foreground uppercase">Teak for…</p>
      <h2 class="mb-2.5 text-[1.375rem] leading-[1.2] font-bold tracking-[-0.025em] text-balance" id="audiences-title">
        Made for the way you work
      </h2>
      <p class="mx-auto max-w-lg text-[0.9375rem] leading-[1.6] text-balance text-muted-foreground">
        Pick yours to see the features that matter to you.
      </p>
    </div>

    <ul class="grid list-none grid-cols-1 gap-4 p-0 min-[561px]:grid-cols-2 min-[1024px]:grid-cols-4">
      {audiences.map(({ page, thumbs }) => (
        <li class="min-w-0">
          <a class="group flex h-full flex-col rounded-xl border border-border bg-card p-3 pb-5 text-card-foreground no-underline transition-colors hover:border-primary/40" href={`/${page.slug}`}>
            <div aria-hidden="true" class="grid grid-cols-3 gap-1.5">
              {thumbs.map((card) => (
                <span class="block aspect-square overflow-hidden rounded-md border border-border/70 bg-muted">
                  {card.image ? (
                    <img alt="" class:list={["size-full object-cover", { "object-left-top": card.type === "link" || card.type === "document" }]} height={card.image.height} loading="lazy" src={card.image.src} width={card.image.width} />
                  ) : card.type === "palette" && card.colors ? (
                    <span class="flex size-full flex-col">
                      {card.colors.map((color) => (
                        <span class="flex-1" style={`background:${color}`} />
                      ))}
                    </span>
                  ) : (
                    <span class="flex size-full items-center justify-center text-muted-foreground">
                      <Icon name={DEMO_CARD_TYPES[card.type].icon} size={16} />
                    </span>
                  )}
                </span>
              ))}
            </div>
            <h3 class="mt-5 flex items-start px-2 justify-between gap-3 text-base leading-[1.3] font-semibold text-balance">
              {page.navLabel}
              <span aria-hidden="true" class="mt-px text-muted-foreground transition-transform group-hover:translate-x-0.5">→</span>
            </h3>
            <p class="mt-2 px-2 text-[0.8125rem] leading-[1.6] text-pretty text-muted-foreground">{page.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

