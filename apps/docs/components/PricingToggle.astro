---
import { yearlySavingsPercent } from "../lib/pricing";

const activeClass =
  "relative inline-flex items-center rounded-full px-4 py-1.5 font-medium border bg-background text-foreground cursor-pointer";
const idleClass =
  "relative inline-flex items-center rounded-full px-4 py-1.5 font-medium border border-transparent text-muted-foreground hover:text-foreground cursor-pointer";
---

<div class="mb-8 flex items-center justify-center">
  <div
    aria-label="Billing period"
    class="relative inline-flex rounded-full border bg-muted p-1"
    data-active-class={activeClass}
    data-idle-class={idleClass}
    data-pricing-toggle-group
    role="group"
  >
    <button
      aria-pressed="false"
      class={idleClass}
      data-pricing-toggle="monthly"
      type="button"
    >
      Monthly
    </button>
    <button
      aria-pressed="true"
      class={activeClass}
      data-pricing-toggle="yearly"
      type="button"
    >
      Yearly
      <span class="save-badge">
        Save {yearlySavingsPercent()}%
      </span>
    </button>
  </div>
</div>

<script>
  const group = document.querySelector<HTMLElement>("[data-pricing-toggle-group]");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-pricing-toggle]");
  const monthlyPrices = document.querySelectorAll<HTMLElement>("[data-price-monthly]");
  const yearlyPrices = document.querySelectorAll<HTMLElement>("[data-price-yearly]");

  const restartAnimation = (el: HTMLElement, className: string) => {
    el.classList.remove(className);
    void el.offsetWidth;
    el.classList.add(className);
  };

  const show = (elements: NodeListOf<HTMLElement>, visible: boolean) => {
    for (const el of elements) {
      el.classList.toggle("hidden", !visible);
      if (visible) {
        restartAnimation(el, "price-enter");
      }
    }
  };

  for (const btn of buttons) {
    btn.addEventListener("click", () => {
      const isYearly = btn.dataset.pricingToggle === "yearly";
      const period = isYearly ? "yearly" : "monthly";

      for (const b of buttons) {
        const active = b.dataset.pricingToggle === period;
        b.className = (active ? group?.dataset.activeClass : group?.dataset.idleClass) ?? "";
        b.setAttribute("aria-pressed", String(active));
      }

      show(monthlyPrices, !isYearly);
      show(yearlyPrices, isYearly);
    });
  }
</script>

<style>
  .save-badge {
    margin-left: 0.5rem;
    padding: 0.125rem 0.375rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--primary) 10%, transparent);
    color: var(--primary);
    font-size: 0.6875rem;
    font-weight: 600;
  }
</style>
