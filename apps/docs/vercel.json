{
  "buildCommand": "bun run build",
  "redirects": [
    {
      "source": "/docs/desktop",
      "destination": "/docs/mac",
      "permanent": true
    },
    {
      "source": "/docs/desktop.md",
      "destination": "/docs/mac.md",
      "permanent": true
    },
    {
      "source": "/docs/desktop.mdx",
      "destination": "/docs/mac.mdx",
      "permanent": true
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/llms-small.txt",
      "destination": "/llms.txt",
      "permanent": true
    },
    {
      "source": "/docs/index.md",
      "destination": "/docs.md",
      "permanent": true
    },
    {
      "source": "/docs/skills",
      "destination": "/docs/ai-agents",
      "permanent": true
    },
    {
      "source": "/docs/skills/",
      "destination": "/docs/ai-agents",
      "permanent": true
    },
    {
      "source": "/docs/skills.md",
      "destination": "/docs/ai-agents.md",
      "permanent": true
    },
    {
      "source": "/docs/skills.mdx",
      "destination": "/docs/ai-agents.mdx",
      "permanent": true
    },
    {
      "source": "/changelog/09-:day",
      "destination": "/changelog/september-2026",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/docs",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/docs.md",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/docs/:path*",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/changelog/:path*",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/reference/operations/:path*",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    }
  ],
  "installCommand": "bun install",
  "framework": null,
  "outputDirectory": "dist",
  "bunVersion": "1.x"
}
