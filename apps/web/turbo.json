{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "GITHUB_SHA",
        "GIT_SHA",
        "VITE_PUBLIC_CONVEX_URL",
        "VITE_PUBLIC_FILES_BASE",
        "VITE_PUBLIC_POSTHOG_PROJECT_TOKEN",
        "TEAK_ANALYTICS_ENABLED",
        "WORKERS_CI_COMMIT_SHA"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "passThroughEnv": ["POSTHOG_CLI_API_KEY", "POSTHOG_CLI_PROJECT_ID"],
      "outputs": ["dist/**"]
    },
    "preview": {
      "passThroughEnv": ["PORT"]
    },
    "typecheck": {},
    "dev": {
      "passThroughEnv": ["PORT"]
    }
  }
}
