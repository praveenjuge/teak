{
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "build": {
      "env": [
        "GIT_SHA",
        "GITHUB_SHA",
        "SENTRY_RELEASE",
        "VERCEL_GIT_COMMIT_SHA"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"]
    },
    "test:e2e": {
      "passThroughEnv": [
        "E2E_BETTER_AUTH_USER_EMAIL",
        "E2E_BETTER_AUTH_USER_PASSWORD",
        "E2E_TEST_EMAIL",
        "E2E_TEST_PASSWORD",
        "SKIP_AUTH_TESTS",
        "TEAK_DEV_APP_URL"
      ]
    },
    "typecheck": {
      "outputs": ["tsconfig.tsbuildinfo"]
    }
  }
}
