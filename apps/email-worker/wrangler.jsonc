{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Save by email: Cloudflare Email Routing's catch-all rule for
  // in.teakvault.com sends every message here (README.md). It has no HTTP
  // routes; it only posts signed requests to Convex and Files Worker uploads.
  "name": "teak-email-prod",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  // Secret (wrangler secret put, never in this file):
  // EMAIL_INBOUND_SIGNING_SECRET, the same value as Convex production's.
  "vars": {
    // The production Convex deployment's HTTP origin (/inbound/email).
    "CONVEX_SITE_URL": "https://uncommon-ladybug-882.convex.site",
    // Only save@ (and save+anything@) on this domain is accepted.
    "INBOUND_EMAIL_DOMAIN": "in.teakvault.com",
    // The text and HTML bodies are each cut to this many UTF-8 bytes.
    "MAX_BODY_BYTES": "1048576"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
