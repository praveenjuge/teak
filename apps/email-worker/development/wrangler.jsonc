{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Development Save by email: Email Routing's catch-all rule for
  // in-dev.teakvault.com points here and saves to the shared dev deployment.
  // Deploy with `bun run deploy:development`.
  "name": "teak-email-in-development",
  "main": "../src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  // Secret: EMAIL_INBOUND_SIGNING_SECRET, the same value as Convex dev's.
  "vars": {
    "CONVEX_SITE_URL": "https://reminiscent-kangaroo-59.convex.site",
    "INBOUND_EMAIL_DOMAIN": "in-dev.teakvault.com",
    "MAX_BODY_BYTES": "1048576"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
