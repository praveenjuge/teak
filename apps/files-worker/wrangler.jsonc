{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teak-files-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "routes": [
    {
      "pattern": "files.teakvault.com",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "teak-files-prod"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
