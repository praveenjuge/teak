{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teak-files-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "files.teakvault.com",
      "custom_domain": true
    },
    // The public API, MCP server and their OAuth discovery documents on the
    // marketing site, proxied to Convex by src/apiProxy.ts. The rest of
    // teakvault.com stays on its own origin. Patterns end in "*" so query
    // strings match; paths Convex does not serve fall through to the origin.
    { "pattern": "teakvault.com/api*", "zone_name": "teakvault.com" },
    { "pattern": "teakvault.com/mcp*", "zone_name": "teakvault.com" },
    {
      "pattern": "teakvault.com/.well-known/oauth-protected-resource*",
      "zone_name": "teakvault.com"
    },
    {
      "pattern": "teakvault.com/.well-known/teak-oauth-clients.json*",
      "zone_name": "teakvault.com"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "teak-files-prod"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "OBJECT_GATES", "class_name": "ObjectDeletionGate" },
      { "name": "MEDIA_RENDERER", "class_name": "MediaRenderer" },
      { "name": "LINK_FETCHER", "class_name": "LinkFetcher" }
    ]
  },
  "migrations": [
    {
      "tag": "object-deletion-gates-v1",
      "new_sqlite_classes": ["ObjectDeletionGate"]
    },
    {
      "tag": "media-renderer-v1",
      "new_sqlite_classes": ["MediaRenderer"]
    },
    {
      "tag": "link-fetcher-v1",
      "new_sqlite_classes": ["LinkFetcher"]
    }
  ],
  // Media renderer: ffmpeg and poppler for video frames, scrub sprites, media
  // facts, audio waveforms and conversion, and PDF thumbnails and text. One
  // job per instance, no internet; see container/Dockerfile.
  "containers": [
    {
      "class_name": "MediaRenderer",
      "image": "./container/Dockerfile",
      "instance_type": "basic",
      "max_instances": 4
    },
    // Link fetcher: the only Container with internet access. It downloads
    // remote preview images and media under Convex's SSRF policy, pinned to
    // the addresses it checked, and the Worker stores them in R2; see
    // fetcher/Dockerfile. Its build context is the repository root so it can
    // bundle that policy by path.
    {
      "class_name": "LinkFetcher",
      "image": "./fetcher/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 4
    }
  ],
  "ai": {
    "binding": "AI",
    // AI bindings always access remote resources, even in local dev.
    "remote": true
  },
  "images": {
    "binding": "IMAGES"
  },
  // Browser Run: offline HTML screenshots and scrapes.
  "browser": {
    "binding": "BROWSER"
  },
  // This config deploys the production custom domain. Local dev overrides it.
  // Workers Paid. Exports stream up to 10,000 files (5 GB) into one ZIP in a
  // single request: CPU for the ZIP's checksums, and one R2 read per file plus
  // the upload parts. Other operations use a small fraction of either limit.
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 20000
  },
  "vars": {
    // AI Gateway for every Workers AI call (src/aiGateway.ts). Create it in
    // the dashboard before deploying: a named gateway must exist first.
    "AI_GATEWAY_ID": "teak-files",
    // Public PostHog project token for error reports (production only).
    "POSTHOG_PROJECT_TOKEN": "phc_nMZjok7SyRwAJVbk34ifkYukb3vzhLBx89WQLju89yBn",
    // Matches containers[0].max_instances.
    "MEDIA_RENDERER_INSTANCES": "4",
    // Matches containers[1].max_instances.
    "LINK_FETCHER_INSTANCES": "4",
    // src/apiProxy.ts: requests to this host's API paths go to the
    // production Convex deployment's HTTP origin.
    "API_PUBLIC_HOST": "teakvault.com",
    "API_UPSTREAM_ORIGIN": "https://uncommon-ladybug-882.convex.site"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
