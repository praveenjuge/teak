{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teak-files-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "files.teakvault.com",
      "custom_domain": true
    },
    // The public API, MCP server and their OAuth discovery documents on the
    // marketing site, proxied to Convex by src/apiProxy.ts. The rest of
    // teakvault.com stays on its own origin. Patterns end in "*" so query
    // strings match; paths Convex does not serve fall through to the origin.
    { "pattern": "teakvault.com/api*", "zone_name": "teakvault.com" },
    { "pattern": "teakvault.com/mcp*", "zone_name": "teakvault.com" },
    {
      "pattern": "teakvault.com/.well-known/oauth-protected-resource*",
      "zone_name": "teakvault.com"
    },
    {
      "pattern": "teakvault.com/.well-known/teak-oauth-clients.json*",
      "zone_name": "teakvault.com"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "teak-files-prod"
    }
  ],
  // src/edgeIdentity.ts: which user each API key hash or WorkOS user belongs
  // to, cached for edge rate limits.
  // src/edgeRateLimit.ts: per-user (and per-address) limits on the public
  // API and MCP server. Counted per Cloudflare location in fixed windows; the
  // limits match EDGE_API_REQUEST_LIMIT and EDGE_UNKNOWN_CREDENTIAL_LIMIT.
  // namespace_id must be unique across the account.
  "ratelimits": [
    {
      "name": "API_REQUEST_LIMITER",
      "namespace_id": "6941",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "UNKNOWN_CREDENTIAL_LIMITER",
      "namespace_id": "6942",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EDGE_IDENTITY",
      "id": "d53e5a8c82194effbbb281eab9875615"
    },
    {
      // fetch-link-page results for a day (src/linkPage.ts).
      "binding": "LINK_PAGE_CACHE",
      "id": "bdda56e1f09b4ff68fbec54123fb1d4d"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "OBJECT_GATES", "class_name": "ObjectDeletionGate" },
      { "name": "MEDIA_RENDERER", "class_name": "MediaRenderer" },
      { "name": "LINK_FETCHER", "class_name": "LinkFetcher" }
    ]
  },
  "migrations": [
    {
      "tag": "object-deletion-gates-v1",
      "new_sqlite_classes": ["ObjectDeletionGate"]
    },
    {
      "tag": "media-renderer-v1",
      "new_sqlite_classes": ["MediaRenderer"]
    },
    {
      "tag": "link-fetcher-v1",
      "new_sqlite_classes": ["LinkFetcher"]
    }
  ],
  // Media renderer: ffmpeg and poppler for video frames, scrub sprites, media
  // facts, audio waveforms and conversion, and PDF thumbnails and text. One
  // job per instance, no internet; see container/Dockerfile.
  "containers": [
    {
      "class_name": "MediaRenderer",
      "image": "./container/Dockerfile",
      "instance_type": "basic",
      "max_instances": 4
    },
    // Link fetcher: the only Container with internet access. It downloads
    // remote preview images and media under Convex's SSRF policy, pinned to
    // the addresses it checked, and the Worker stores them in R2; see
    // fetcher/Dockerfile. Its build context is the repository root so it can
    // bundle that policy by path.
    {
      "class_name": "LinkFetcher",
      "image": "./fetcher/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 4
    }
  ],
  "ai": {
    "binding": "AI",
    // AI bindings always access remote resources, even in local dev.
    "remote": true
  },
  "images": {
    "binding": "IMAGES"
  },
  // Browser Run: offline HTML screenshots and scrapes.
  "browser": {
    "binding": "BROWSER"
  },
  // Card embeddings for semantic search: one 768-dimension cosine index per
  // shard, one namespace per user (packages/files-protocol/src/embeddings.ts).
  "vectorize": [
    {
      "binding": "CARD_VECTORS_0",
      "index_name": "teak-cards-0"
    }
  ],
  // Background work (src/workflows/): Convex records it and dispatches it here
  // with the `dispatch` op; steps call this Worker's ops in-process and read
  // and write Convex through its signed workflow RPC gateway. Instance IDs are
  // deterministic, so a repeated dispatch is a no-op.
  "workflows": [
    {
      "name": "teak-card-processing",
      "binding": "CARD_PROCESSING",
      "class_name": "CardProcessingWorkflow"
    },
    {
      "name": "teak-export",
      "binding": "EXPORTS",
      "class_name": "ExportWorkflow"
    },
    {
      "name": "teak-import",
      "binding": "IMPORTS",
      "class_name": "ImportWorkflow"
    },
    {
      "name": "teak-account-deletion",
      "binding": "ACCOUNT_DELETION",
      "class_name": "AccountDeletionWorkflow"
    },
    {
      "name": "teak-maintenance",
      "binding": "MAINTENANCE",
      "class_name": "MaintenanceWorkflow"
    }
  ],
  // Queues (src/queues/). Object deletions come from Convex through
  // `dispatch`; AI backfill from the 6-hourly cron; WorkOS events from the
  // webhook route; R2 events from the bucket's event notification.
  "queues": {
    "producers": [
      { "binding": "OBJECT_DELETIONS", "queue": "teak-object-deletions" },
      { "binding": "AI_BACKFILL", "queue": "teak-ai-backfill" },
      { "binding": "WORKOS_EVENTS", "queue": "teak-workos-events" },
      { "binding": "R2_EVENTS", "queue": "teak-r2-events" }
    ],
    "consumers": [
      {
        "queue": "teak-object-deletions",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "teak-object-deletions-dlq"
      },
      {
        "queue": "teak-object-deletions-dlq",
        "max_batch_size": 10,
        "max_retries": 2
      },
      {
        "queue": "teak-ai-backfill",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_concurrency": 2,
        "max_retries": 10,
        "retry_delay": 60
      },
      {
        "queue": "teak-workos-events",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 10,
        "retry_delay": 30,
        "dead_letter_queue": "teak-workos-events-dlq"
      },
      {
        "queue": "teak-workos-events-dlq",
        "max_batch_size": 10,
        "max_retries": 5
      },
      {
        "queue": "teak-r2-events",
        "max_batch_size": 100,
        "max_batch_timeout": 30,
        "max_retries": 5
      }
    ]
  },
  // AI usage per Workers AI call (src/aiUsage.ts), rolled up into Convex's
  // aiUsageDaily every hour.
  "analytics_engine_datasets": [
    { "binding": "AI_USAGE", "dataset": "teak_ai_usage" }
  ],
  // Background tasks that used to be Convex crons (src/cron.ts). Each records
  // the Convex cron heartbeat the admin health view reads.
  "triggers": {
    "crons": ["0 2 * * *", "0 3 * * *", "0 */6 * * *", "0 4 * * 1", "15 * * * *", "45 * * * *"]
  },
  // This config deploys the production custom domain. Local dev overrides it.
  // Workers Paid. Exports stream up to 10,000 files (5 GB) into one ZIP in a
  // single request: CPU for the ZIP's checksums, and one R2 read per file plus
  // the upload parts. Other operations use a small fraction of either limit.
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 20000
  },
  "vars": {
    // AI Gateway for every Workers AI call (src/aiGateway.ts). Create it in
    // the dashboard before deploying: a named gateway must exist first.
    "AI_GATEWAY_ID": "teak-files",
    // Public PostHog project token for error reports (production only).
    "POSTHOG_PROJECT_TOKEN": "phc_nMZjok7SyRwAJVbk34ifkYukb3vzhLBx89WQLju89yBn",
    // Matches containers[0].max_instances.
    "MEDIA_RENDERER_INSTANCES": "4",
    // Matches containers[1].max_instances.
    "LINK_FETCHER_INSTANCES": "4",
    // src/apiProxy.ts: requests to this host's API paths go to the
    // production Convex deployment's HTTP origin.
    "API_PUBLIC_HOST": "teakvault.com",
    "API_UPSTREAM_ORIGIN": "https://uncommon-ladybug-882.convex.site",
    // src/edgeIdentity.ts: issuer of the WorkOS access tokens the API accepts,
    // the production deployment's WORKOS_AUTHKIT_DOMAIN.
    "API_WORKOS_ISSUER": "https://scholarly-hay-77.authkit.app",
    // The Convex deployments whose background work this Worker runs; the
    // first is primary. Development shares this Worker until the storage
    // switch, so its deployment is listed too.
    "CONVEX_SITE_URLS": "https://uncommon-ladybug-882.convex.site,https://reminiscent-kangaroo-59.convex.site",
    // In-process ops transform large images through this Worker's own URL.
    "FILES_PUBLIC_ORIGIN": "https://files.teakvault.com",
    // The account the Analytics Engine SQL API reads (src/aiUsage.ts).
    "ANALYTICS_ACCOUNT_ID": "dd19e45b8f2f3cc0393cc2deb51fa27d"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
