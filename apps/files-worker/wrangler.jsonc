{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teak-files-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/heic_dec.wasm",
        "**/resvg-wasm/index_bg.wasm",
        "**/webp_enc_simd.wasm"
      ],
      "fallthrough": true
    }
  ],
  "routes": [
    {
      "pattern": "files.teakvault.com",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "teak-files-prod"
    }
  ]
}
