{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teak-files-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Required by @sentry/cloudflare (AsyncLocalStorage-based request context).
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "files.teakvault.com",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "teak-files-prod"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "OBJECT_GATES", "class_name": "ObjectDeletionGate" }]
  },
  "migrations": [
    {
      "tag": "object-deletion-gates-v1",
      "new_sqlite_classes": ["ObjectDeletionGate"]
    }
  ],
  "ai": {
    "binding": "AI",
    // AI bindings always access remote resources, even in local dev.
    "remote": true
  },
  "images": {
    "binding": "IMAGES"
  },
  // Browser Run: PDF thumbnails and offline HTML screenshots/scrapes.
  "browser": {
    "binding": "BROWSER"
  },
  // Media Transformations: video frames read straight from R2 (remote only).
  "media": {
    "binding": "MEDIA",
    "remote": true
  },
  // This config deploys the production custom domain. Local dev overrides it.
  // Workers Paid. Exports stream up to 10,000 files (5 GB) into one ZIP in a
  // single request: CPU for the ZIP's checksums, and one R2 read per file plus
  // the upload parts. Other operations use a small fraction of either limit.
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 20000
  },
  "vars": {
    "SENTRY_ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
