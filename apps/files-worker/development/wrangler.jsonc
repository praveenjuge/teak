{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Isolated development Worker. Prepared only: Convex dev keeps the shared
  // production routing until the approved storage switch. Deploy with
  // `bun run deploy:development`; never add the production custom domain.
  "name": "teak-files-development",
  "account_id": "dd19e45b8f2f3cc0393cc2deb51fa27d",
  "main": "../src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "teak-files-development-20261006",
      "preview_bucket_name": "teak-files-development-20261006"
    }
  ],
  // Its own SQLite namespace; never reference the production script's gates.
  "durable_objects": {
    "bindings": [
      { "name": "OBJECT_GATES", "class_name": "ObjectDeletionGate" },
      { "name": "MEDIA_RENDERER", "class_name": "MediaRenderer" }
    ]
  },
  "migrations": [
    {
      "tag": "development-object-deletion-gates-v1",
      "new_sqlite_classes": ["ObjectDeletionGate"]
    },
    {
      "tag": "development-media-renderer-v1",
      "new_sqlite_classes": ["MediaRenderer"]
    }
  ],
  // Media renderer: ffmpeg and poppler for video frames, scrub sprites, media
  // facts, audio waveforms and conversion, and PDF thumbnails and text. One
  // job per instance, no internet; see container/Dockerfile.
  "containers": [
    {
      "class_name": "MediaRenderer",
      "image": "../container/Dockerfile",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "browser": {
    "binding": "BROWSER"
  },
  // Workers Paid. Exports stream up to 10,000 files (5 GB) into one ZIP in a
  // single request: CPU for the ZIP's checksums, and one R2 read per file plus
  // the upload parts. Other operations use a small fraction of either limit.
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 20000
  },
  "vars": {
    // Its own AI Gateway, so development traffic stays out of production's
    // analytics. Create it in the dashboard before deploying.
    "AI_GATEWAY_ID": "teak-files-development",
    // Matches containers[0].max_instances.
    "MEDIA_RENDERER_INSTANCES": "2"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
