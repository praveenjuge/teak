{
  "name": "@teak/files-worker",
  "version": "1.0.88",
  "private": true,
  "scripts": {
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check",
    "check": "bun run ../../scripts/check-cloudflare.ts",
    "deploy": "wrangler deploy",
    "deploy:development": "wrangler deploy --config development/wrangler.jsonc",
    "dev": "bun --no-env-file run ../../scripts/files-worker-dev.ts",
    "dev:local": "wrangler dev --var POSTHOG_PROJECT_TOKEN:",
    "fetcher:live-check": "bun fetcher/scripts/live-check.ts",
    "test": "bun test src container/src fetcher/src",
    "typecheck": "tsc --noEmit && tsc -p container --noEmit && tsc -p fetcher --noEmit"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@cloudflare/puppeteer": "1.4.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@streamparser/json": "^0.0.26",
    "@teak/convex": "workspace:*",
    "@teak/files-protocol": "workspace:*",
    "client-zip": "^2.4.5",
    "convex": "^1.46.0",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0"
  },
  "devDependencies": {
    "@types/probe-image-size": "^7.2.5",
    "jose": "6.2.12",
    "probe-image-size": "7.4.0",
    "undici": "^7.30.0",
    "wrangler": "^4.151.0"
  }
}
