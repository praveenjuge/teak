{
  "name": "@teak/files-worker",
  "version": "1.0.86",
  "private": true,
  "scripts": {
    "cf-typegen": "wrangler types",
    "check": "bun run ../../scripts/check-cloudflare.ts",
    "deploy": "wrangler deploy",
    "deploy:development": "wrangler deploy --config development/wrangler.jsonc",
    "dev": "wrangler dev --remote --var POSTHOG_PROJECT_TOKEN:",
    "dev:development": "bun --no-env-file run ../../scripts/files-worker-dev.ts",
    "dev:local": "wrangler dev --var POSTHOG_PROJECT_TOKEN:",
    "test": "bun test src container/src",
    "typecheck": "tsc --noEmit && tsc -p container --noEmit"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@cloudflare/puppeteer": "1.4.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@streamparser/json": "^0.0.26",
    "@teak/convex": "workspace:*",
    "@teak/files-protocol": "workspace:*",
    "client-zip": "^2.4.5",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "wrangler": "^4.136.1"
  }
}
