# Copy to self-host/.env (ignored by git) and fill it in. `bun run deploy:self-host`
# passes these to `wrangler deploy` as vars, so self-host/wrangler.jsonc stays
# untouched. See "Self-hosting" in apps/core-worker/README.md.

# Required. Your Convex deployment's CONVEX_SITE_URL. List more than one,
# comma-separated, only if this Worker serves several deployments.
CONVEX_SITE_URLS=https://your-deployment.convex.site

# Required. The origin files are served from: the same value as FILES_BASE on
# Convex. A custom domain such as https://files.example.com is attached to the
# Worker on deploy (its zone must be on Cloudflare). Before you have one, use
# https://teak-core-worker.<your-subdomain>.workers.dev.
FILES_PUBLIC_ORIGIN=https://files.example.com

# Optional. Serve the public API and MCP at https://<API_PUBLIC_HOST>/api and
# /mcp through the Worker's rate-limited edge proxy. Needs API_WORKOS_ISSUER
# (your WORKOS_AUTHKIT_DOMAIN). API_UPSTREAM_ORIGIN defaults to the first
# CONVEX_SITE_URLS entry.
# API_PUBLIC_HOST=example.com
# API_WORKOS_ISSUER=https://your-domain.authkit.app
# API_UPSTREAM_ORIGIN=https://your-deployment.convex.site

# Optional. Save by email's subdomain (default in.teakvault.com).
# INBOUND_EMAIL_DOMAIN=in.example.com

# Optional. Your Cloudflare account ID, for the hourly AI usage rollup (it also
# needs the ANALYTICS_API_TOKEN secret).
# ANALYTICS_ACCOUNT_ID=

# Optional. Your own PostHog project token. Unset sends nothing.
# POSTHOG_PROJECT_TOKEN=

# Optional. An AI Gateway for Workers AI calls. Unset calls Workers AI directly.
# AI_GATEWAY_ID=
