#!/usr/bin/env bash
# Prepares a fresh Linux VM for a cloud agent: the pinned Node and Bun,
# workspace packages, and this checkout's wiring to the shared cloud dev
# deployment. That last step needs CONVEX_DEPLOY_KEY, a dev deploy key for the
# dev deployment, in the environment's secrets; without it the VM still runs
# unit tests and the E2E suite (which needs no secrets). Safe to re-run.
#
# - Claude Code on the web: set the environment's setup script to
#   `bash .agents/setup`; the SessionStart hook also runs it when needed.
#   The environment's secrets aren't set while a setup script runs, so there
#   the last step always skips; the hook runs `.agents/setup --session` to do
#   it, and to reinstall when bun.lock has moved past the cached snapshot.
# - Codex cloud: set the environment's setup script to `bash .agents/setup`.
# - Amp: runs it as the orb setup script; .agents/resume restores the PATH.
#
# `--session` runs only the steps that depend on the checkout and the
# secrets (dependencies and the dev deployment), for a VM whose toolchain and
# browsers are already in place.
#
# Start the stack afterwards with `bun run dev --detach`.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local label="$1"
  shift
  local started=$SECONDS
  printf '\n==> %s\n' "$label"
  # Return the failure itself: under `step … || …`, set -e doesn't stop here.
  "$@" || return
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started))"
}

read_pin() {
  local field="$1"
  local value
  case "$field" in
    bun)
      value="$(sed -nE 's/.*"packageManager"[[:space:]]*:[[:space:]]*"bun@([^"]+)".*/\1/p' package.json)"
      ;;
    node)
      value="$(sed -nE 's/.*"node"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' package.json)"
      ;;
    *)
      return 1
      ;;
  esac
  if [[ ! "$value" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf 'Could not read the exact %s version from package.json.\n' "$field" >&2
    return 1
  fi
  printf '%s\n' "$value"
}

install_system_packages() {
  local -a packages=()
  command -v curl >/dev/null 2>&1 || packages+=(curl)
  command -v git >/dev/null 2>&1 || packages+=(git)
  # bun run dev checks its processes' command lines with ps.
  command -v ps >/dev/null 2>&1 || packages+=(procps)
  command -v tar >/dev/null 2>&1 || packages+=(tar)
  command -v unzip >/dev/null 2>&1 || packages+=(unzip)
  command -v xz >/dev/null 2>&1 || packages+=(xz-utils)
  [[ -f /etc/ssl/certs/ca-certificates.crt ]] || packages+=(ca-certificates)

  if ((${#packages[@]} == 0)); then
    printf 'Required system packages are already installed.\n'
    return
  fi

  if ((EUID == 0)); then
    env DEBIAN_FRONTEND=noninteractive apt-get update
    env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${packages[@]}"
  elif command -v sudo >/dev/null 2>&1; then
    sudo env DEBIAN_FRONTEND=noninteractive apt-get update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${packages[@]}"
  else
    printf 'Missing system packages (%s) and sudo is unavailable.\n' "${packages[*]}" >&2
    return 1
  fi
}

platform_arch() {
  case "$(uname -m)" in
    x86_64) printf 'x64\n' ;;
    aarch64 | arm64) printf 'arm64\n' ;;
    *)
      printf 'Unsupported architecture: %s\n' "$(uname -m)" >&2
      return 1
      ;;
  esac
}

install_node() {
  local version="$1"
  local arch="$2"
  local install_dir="$HOME/.local/share/teak-toolchains/node-v${version}-linux-${arch}"
  local archive="node-v${version}-linux-${arch}.tar.xz"

  if [[ ! -x "$install_dir/bin/node" ]] || [[ "$("$install_dir/bin/node" --version)" != "v$version" ]]; then
    local temp_dir
    temp_dir="$(mktemp -d)"
    curl --fail --location --retry 3 --silent --show-error \
      "https://nodejs.org/dist/v${version}/${archive}" \
      --output "$temp_dir/$archive"
    tar -xJf "$temp_dir/$archive" -C "$temp_dir"
    mkdir -p "$(dirname "$install_dir")"
    rm -rf "$install_dir"
    mv "$temp_dir/node-v${version}-linux-${arch}" "$install_dir"
    rm -rf "$temp_dir"
  fi

  mkdir -p "$HOME/.local/bin"
  local command
  for command in node npm npx corepack; do
    ln -sfn "$install_dir/bin/$command" "$HOME/.local/bin/$command"
  done
}

install_bun() {
  local version="$1"
  local arch="$2"
  local bun_arch="$arch"
  [[ "$bun_arch" == "arm64" ]] && bun_arch="aarch64"
  local install_dir="$HOME/.local/share/teak-toolchains/bun-v${version}-linux-${bun_arch}"
  local archive="bun-linux-${bun_arch}.zip"

  if [[ ! -x "$install_dir/bin/bun" ]] || [[ "$("$install_dir/bin/bun" --version)" != "$version" ]]; then
    local temp_dir
    temp_dir="$(mktemp -d)"
    curl --fail --location --retry 3 --silent --show-error \
      "https://github.com/oven-sh/bun/releases/download/bun-v${version}/${archive}" \
      --output "$temp_dir/$archive"
    unzip -q "$temp_dir/$archive" -d "$temp_dir"
    mkdir -p "$install_dir/bin"
    install -m 0755 "$temp_dir/bun-linux-${bun_arch}/bun" "$install_dir/bin/bun"
    rm -rf "$temp_dir"
  fi

  mkdir -p "$HOME/.local/bin"
  ln -sfn "$install_dir/bin/bun" "$HOME/.local/bin/bun"
  ln -sfn "$install_dir/bin/bun" "$HOME/.local/bin/bunx"
}

persist_path() {
  local profile="$HOME/.bash_profile"
  local marker="# Teak cloud toolchain"
  touch "$profile"
  if ! grep -Fqx "$marker" "$profile"; then
    cat >>"$profile" <<'EOF'

# Teak cloud toolchain
export PATH="$HOME/.local/bin:$PATH"
EOF
  fi
}

# The same stamp scripts/setup.ts and the doctor's deps-lock check use
# (scripts/capabilities.ts): the sha256 of the bun.lock node_modules was
# installed from. A fresh clone gives every file the same mtime, so comparing
# timestamps can't tell a lockfile that moved on.
install_stamp=node_modules/.teak-install

lock_hash() {
  sha256sum bun.lock | cut -c1-64
}

dependencies_changed=false

install_dependencies() {
  if [[ -f "$install_stamp" && "$(cat "$install_stamp")" == "$(lock_hash)" ]]; then
    printf 'node_modules is already current with bun.lock.\n'
    return
  fi
  bun ci
  lock_hash | tr -d '\n' >"$install_stamp"
  dependencies_changed=true
}

# The image's browsers in /opt/pw-browsers are an older build than the
# Playwright version the e2e web engine pins, and Playwright would prune them
# if installed alongside, so the E2E suite gets its own copy: Chromium for the
# suite, WebKit (with its system libraries) for the browser matrix. The
# SessionStart hook points PLAYWRIGHT_BROWSERS_PATH here.
install_e2e_browsers() {
  env -u PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD \
    PLAYWRIGHT_BROWSERS_PATH="$HOME/.cache/ms-playwright" \
    bun --cwd=packages/tests x e2e-web install --with-deps chromium webkit
}

# Every cloud VM starts with an empty Turbo cache, so the first typecheck
# takes about two minutes on 4 vCPUs (one second once cached). Warm it here,
# so it lands in the setup script's cached snapshot; unchanged packages then
# hit it in later sessions. The snapshot is only taken when the whole script
# finishes in about five minutes, so this stops before that whatever happens:
# Turbo saves each finished task, so a cut-off run still caches most of them.
warm_turbo_cache() {
  local budget=$((270 - SECONDS))
  if ((budget < 60)); then
    printf 'Skipped: setup has already run %ss.\n' "$SECONDS"
    return
  fi
  timeout "$budget" env TURBO_UI=false bun x turbo run typecheck \
    --output-logs=none ||
    printf 'Stopped after %ss; the tasks that finished are cached.\n' "$budget"
}

bootstrap_development() {
  if [[ "${CONVEX_DEPLOY_KEY:-}" != dev:* ]]; then
    printf 'Skipped: add CONVEX_DEPLOY_KEY (a dev deploy key for the shared dev deployment) to this environment'"'"'s secrets to run bun run dev. See apps/docs/content/docs/(open-source)/development.mdx.\n'
    return
  fi
  TURBO_UI=false bun run setup
  # The extension reads its own VITE_PUBLIC_* file; without it `wxt build`
  # stops with a pointer back here.
  TURBO_UI=false bun run setup --target extension
}

session_only=false
case "${1:-}" in
  "") ;;
  --session) session_only=true ;;
  *)
    printf 'Usage: .agents/setup [--session]\n' >&2
    exit 2
    ;;
esac

if [[ "$(uname -s)" != "Linux" ]]; then
  printf 'This script prepares Linux cloud VMs. Locally, run bun run dev.\n' >&2
  exit 1
fi

if [[ "$session_only" == true ]]; then
  export PATH="$HOME/.local/bin:$PATH"
  step "Install workspace dependencies" install_dependencies
  # A new bun.lock can pin another e2e browser build. If installing it fails,
  # drop the stamp so the next session tries again.
  if [[ "$dependencies_changed" == true ]]; then
    step "Install the E2E suite's browsers" install_e2e_browsers || {
      rm -f "$install_stamp"
      exit 1
    }
  fi
  step "Connect to the shared dev deployment" bootstrap_development
  exit 0
fi

bun_version="$(read_pin bun)"
node_version="$(read_pin node)"
arch="$(platform_arch)"

step "Install required system packages" install_system_packages
step "Install Node $node_version" install_node "$node_version" "$arch"
step "Install Bun $bun_version" install_bun "$bun_version" "$arch"
persist_path
export PATH="$HOME/.local/bin:$PATH"
hash -r

[[ "$(node --version)" == "v$node_version" ]]
[[ "$(bun --version)" == "$bun_version" ]]

step "Install workspace dependencies" install_dependencies
step "Install the E2E suite's browsers" install_e2e_browsers
step "Connect to the shared dev deployment" bootstrap_development
step "Warm the Turbo cache" warm_turbo_cache

printf '\nTeak setup complete: Node %s, Bun %s. Start the stack with bun run dev --detach.\n' "$(node --version)" "$(bun --version)"
