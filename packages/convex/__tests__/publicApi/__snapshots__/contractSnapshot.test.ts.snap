    "/v1/tags/delete": {
      "post": {
        "description": "Removes a tag from every card. The cards are kept. Returns at once; poll the operation for progress. One tag change runs at a time per account.",
        "operationId": "deleteTag",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "tag": {
                    "description": "The tag to delete, matched ignoring case.",
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "tag",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TagOperationStarted",
                },
              },
            },
            "description": "Tag change started",
          },
          "400": {
            "description": "Invalid tag name",
          },
          "404": {
            "description": "No card has the tag",
          },
          "409": {
            "description": "Another tag change is still running (\`TAG_OPERATION_RUNNING\`)",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Delete a tag",
      },
    },
    "/v1/tags/merge": {
      "post": {
        "description": "Replaces a tag with another on every card; a card that has both keeps one. Returns at once; poll the operation for progress. One tag change runs at a time per account.",
        "operationId": "mergeTags",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "description": "The tag to merge away, matched ignoring case.",
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string",
                  },
                  "into": {
                    "description": "The tag to keep.",
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "from",
                  "into",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TagOperationStarted",
                },
              },
            },
            "description": "Tag change started",
          },
          "400": {
            "description": "Invalid tag name",
          },
          "404": {
            "description": "No card has the tag",
          },
          "409": {
            "description": "Another tag change is still running (\`TAG_OPERATION_RUNNING\`)",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Merge a tag into another",
      },
    },
    "/v1/tags/operations/{operationId}": {
      "get": {
        "operationId": "getTagOperation",
        "parameters": [
          {
            "in": "path",
            "name": "operationId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TagOperation",
                },
              },
            },
            "description": "Tag operation",
          },
          "404": {
            "description": "Tag operation not found",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Get a tag change's progress",
      },
    },
    "/v1/tags/rename": {
      "post": {
        "description": "Renames a tag on every card. Renaming to a different casing of the same tag recases it. Returns at once; poll the operation for progress. One tag change runs at a time per account.",
        "operationId": "renameTag",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "description": "The tag to rename, matched ignoring case.",
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string",
                  },
                  "to": {
                    "description": "The new name, written exactly as given.",
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "from",
                  "to",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TagOperationStarted",
                },
              },
            },
            "description": "Tag change started",
          },
          "400": {
            "description": "Invalid tag name",
          },
          "404": {
            "description": "No card has the tag",
          },
          "409": {
            "description": "Another tag change is still running (\`TAG_OPERATION_RUNNING\`) or a tag with the new name exists (\`TAG_EXISTS\`; merge into it instead)",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Rename a tag",
      },
    },
    "/v1/uploads": {
      "post": {
        "operationId": "createUpload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadRequest",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateUploadResponse",
                },
              },
            },
            "description": "Prepared direct file upload",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Create a presigned upload",
      },
    },
  },
  "servers": [
    {
      "url": "https://teakvault.com/api",
    },
    {
      "url": "https://api.teakvault.com",
    },
    {
      "url": "https://reminiscent-kangaroo-59.convex.site",
    },
  ],
}
