  {
    "_meta": {
      "ui": {
        "resourceUri": "ui://teak/cards.html",
      },
      "ui/resourceUri": "ui://teak/cards.html",
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Search cards",
    },
    "description": "Search cards by text and qualifiers, with the same filters as list_cards. Results include cards related by meaning, not just exact words (mode keyword turns that off). q accepts tag:design (or #design), type:link, is:fav, is:pinned (cards pinned to the top), is:archived, is:done (links marked done), is:todo (articles, books, films, shows, podcasts, music, products, recipes, courses, events, apps and games not yet done), site:github.com (exact host, www. ignored), folder:"Reading list", price:<100 (also >, <=, >= and =, on the amount in any currency; links with a price only), text:"total due" (only the words Teak read in images, video thumbnails, link previews and scanned PDFs) and "quoted phrases"; tags, folders, text: values and price bounds must all match (price:>20 price:<100 is a range), types and sites match any. A - before a word, phrase or qualifier leaves those cards out (design -figma, -tag:old, -is:archived), uppercase OR matches either side (tag:fonts OR tag:type), and parentheses group: (site:github.com OR site:gitlab.com) -is:archived. Lowercase or is a plain word. Cards with a price carry linkPrice { amount, currency }. Cards tagged secret or hidden (isHidden: true) are left out unless the search names one of those tags (#secret, tag:hidden); the plain word secret does not show them. Returns { items, total, pageInfo }, where total counts the items on this page; pass pageInfo.nextCursor as cursor for more.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "archived": {
          "description": "Archived cards: exclude (default) leaves them out, only lists just them, include lists them too",
          "enum": [
            "exclude",
            "only",
            "include",
          ],
          "type": "string",
        },
        "createdAfter": {
          "description": "Unix ms",
          "type": "number",
        },
        "createdBefore": {
          "description": "Unix ms",
          "type": "number",
        },
        "cursor": {
          "description": "pageInfo.nextCursor from the previous page",
          "minLength": 1,
          "type": "string",
        },
        "favorited": {
          "description": "true lists favorites only",
          "type": "boolean",
        },
        "folder": {
          "description": "Only cards in this folder id (see teak_v1_list_folders)",
          "minLength": 1,
          "type": "string",
        },
        "hex": {
          "description": "Exact colors such as #112233",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 24,
          "type": "array",
        },
        "hue": {
          "items": {
            "enum": [
              "red",
              "orange",
              "yellow",
              "green",
              "teal",
              "cyan",
              "blue",
              "purple",
              "pink",
              "brown",
              "neutral",
            ],
            "type": "string",
          },
          "maxItems": 24,
          "type": "array",
        },
        "include": {
          "description": "Extra field sets. Defaults to content and metadata so items are full cards; content is always included.",
          "items": {
            "enum": [
              "content",
              "metadata",
              "processing",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "mode": {
          "description": "How q finds cards: hybrid (default) matches words and meaning, keyword matches words only, semantic matches meaning only. The response's searchMode says which ran",
          "enum": [
            "hybrid",
            "keyword",
            "semantic",
          ],
          "type": "string",
        },
        "pinned": {
          "description": "true lists only cards pinned to the top of the library; without q they come back in their pinned order",
          "type": "boolean",
        },
        "q": {
          "description": "Search text with optional qualifiers: tag:name or #name, type:link, is:fav, is:pinned (cards pinned to the top), is:archived, is:done (links marked done), is:todo (links to read, watch or buy that are not done yet), site:github.com, folder:"Reading list", like:<cardId> (the cards closest in meaning to that card), mood:"moody brutalist" (images by mood), price:<100 (also >, <=, >= and =; only links with a price match), text:"total due" (only the words Teak read in images, video thumbnails, link previews and scanned PDFs) and "quoted phrases". A - before a word, phrase or qualifier leaves those cards out (design -figma, -tag:old; not like: or mood:), uppercase OR matches either side (tag:fonts OR tag:type), and parentheses group: (site:github.com OR site:gitlab.com) -is:archived. Qualifiers combine with the other filters.",
          "type": "string",
        },
        "shuffleSeed": {
          "description": "Required with sort shuffle; the same seed gives the same order, a new one reshuffles",
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer",
        },
        "similarTo": {
          "description": "A card id: only the cards closest to it in meaning (the same as like:<cardId> in q)",
          "minLength": 1,
          "type": "string",
        },
        "sort": {
          "description": "newest (default) or oldest by saved date; shuffle: a stable random order (needs shuffleSeed); or relevance (Best match, with q): the top results by how well they match. relevanceRanked says whether they were scored",
          "enum": [
            "newest",
            "oldest",
            "relevance",
            "shuffle",
          ],
          "type": "string",
        },
        "style": {
          "items": {
            "enum": [
              "abstract",
              "cinematic",
              "dark",
              "illustrative",
              "minimal",
              "monochrome",
              "moody",
              "pastel",
              "photographic",
              "retro",
              "surreal",
              "vintage",
              "vibrant",
              "typographic",
              "3d",
              "flat",
              "geometric",
              "hand-drawn",
              "futuristic",
            ],
            "type": "string",
          },
          "maxItems": 24,
          "type": "array",
        },
        "tag": {
          "description": "Exact tag",
          "minLength": 1,
          "type": "string",
        },
        "trashed": {
          "description": "true lists cards in Trash only",
          "type": "boolean",
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "text",
                "link",
                "image",
                "video",
                "audio",
                "document",
                "palette",
                "quote",
              ],
              "type": "string",
            },
            {
              "items": {
                "enum": [
                  "text",
                  "link",
                  "image",
                  "video",
                  "audio",
                  "document",
                  "palette",
                  "quote",
                ],
                "type": "string",
              },
              "minItems": 1,
              "type": "array",
            },
          ],
          "description": "One card type, or several to match any of them",
        },
      },
      "required": [],
      "type": "object",
    },
    "name": "teak_v1_search_cards",
  },
  {
