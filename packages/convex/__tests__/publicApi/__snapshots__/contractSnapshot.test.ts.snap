      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Create highlight",
    },
    "description": "Highlight a passage of a link card's saved article, found by its text: \`quote\` (at most 5000 characters; whitespace, curly quotes and case needn't match), with an optional note. The first match is used unless \`prefix\` or \`suffix\` (text just around it) points at another. Overlapping highlights merge. A card holds up to 200, and a highlighted link keeps its saved copy and article.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "cardId": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string",
        },
        "note": {
          "maxLength": 2000,
          "type": "string",
        },
        "prefix": {
          "type": "string",
        },
        "quote": {
          "maxLength": 5000,
          "minLength": 1,
          "type": "string",
        },
        "suffix": {
          "type": "string",
        },
      },
      "required": [
        "cardId",
        "quote",
      ],
      "type": "object",
    },
    "name": "teak_v1_create_highlight",
  },
  {
    "annotations": {
