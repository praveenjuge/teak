            },
            "type": "array",
          },
          "pageInfo": {
            "$ref": "#/components/schemas/CardPageInfo",
          },
          "relevanceRanked": {
            "description": "With \`q\` and \`sort=relevance\`: whether the search's top results are ordered by how well they match. \`false\` when scoring was slow, failed, rate-limited, or AI is turned off for the account; the results then keep the search order.",
            "type": "boolean",
          },
          "searchMode": {
            "description": "With \`q\`: how the search found cards. \`keyword\` when meaning search was not used: \`mode=keyword\`, no words to search by meaning, or the meaning service was slow, down or rate-limited.",
            "enum": [
              "hybrid",
              "keyword",
              "semantic",
            ],
            "type": "string",
          },
          "similarity": {
            "description": "With \`similarTo\`, \`like:\` or \`mood:\`: \`pending\` while the card is still being read (try again in a moment), \`unavailable\` for a card in Trash or not found.",
            "enum": [
              "ok",
              "pending",
              "unavailable",
            ],
            "type": "string",
          },
        },
        "required": [
          "items",
          "pageInfo",
        ],
        "type": "object",
      },
      "CreateCardRequest": {
        "properties": {
          "cardType": {
            "description": "Optional explicit card type. Text content is stored as raw Markdown without normalization. When omitted, Teak keeps automatic URL, quote, and palette classification. Uploaded file types are inferred from fileName and mimeType. image, video, audio, and document need an uploaded file (fileKey); palette needs at least one readable color in content, notes, or tags.",
            "enum": [
              "text",
              "link",
              "image",
              "video",
              "audio",
              "document",
              "palette",
              "quote",
            ],
            "type": "string",
          },
          "content": {
            "description": "Card content. For text cards this is canonical raw Markdown, preserved exactly, with a maximum of 512 KiB measured in UTF-8 bytes.",
            "example": 
"  # Draft

- [ ] Keep spacing  
"
,
            "type": "string",
          },
          "fileEtag": {
            "description": "ETag returned by the completed upload PUT. Include it when creating an uploaded-file card so Teak can verify the exact stored object.",
            "example": ""d41d8cd98f00b204e9800998ecf8427e"",
            "type": "string",
          },
          "fileKey": {
            "type": "string",
          },
          "fileName": {
            "type": "string",
          },
          "fileSize": {
            "type": "number",
          },
          "mimeType": {
            "type": "string",
          },
          "notes": {
            "type": [
              "string",
              "null",
            ],
          },
          "pageSnapshotKey": {
            "description": "From POST /v1/page-snapshots/upload: the page as the browser showed it, gzipped, which becomes the link's saved copy instead of the page Teak fetches. Only for links; a key that isn't one of your snapshot uploads is ignored, and the card is still saved. Not allowed with \`fileKey\`.",
            "type": "string",
          },
          "source": {
            "description": "A free label for what saved the card, kept in its metadata. To record the page a card came from, use \`sourceUrl\`.",
            "type": "string",
          },
          "sourceTitle": {
            "description": "The title of the page in \`sourceUrl\`. Trimmed, and cut to 300 characters. Needs \`sourceUrl\`.",
            "type": "string",
          },
          "sourceUrl": {
            "description": "The page the card was saved from, such as the page a quote was selected on: an http or https URL of at most 2048 characters. Unlike \`url\`, it never makes the card a link, and it isn't part of the duplicate check. Not allowed with \`fileKey\`.",
            "example": "https://example.com/essay",
            "type": "string",
          },
          "tags": {
            "items": {
              "maxLength": 64,
              "type": "string",
            },
            "type": "array",
          },
          "url": {
            "type": "string",
          },
        },
        "type": "object",
      },
      "CreateCardResponse": {
        "properties": {
          "appUrl": {
            "format": "uri",
            "type": "string",
          },
          "card": {
            "$ref": "#/components/schemas/Card",
          },
          "cardId": {
            "type": "string",
          },
          "resaved": {
            "description": "Present and true when the link was already in Teak: no card was made, and the card that has it moved to the top of \`sort=newest\` (its \`savedAt\` is now). \`cardId\` and \`card\` are that card. Tags, notes and content sent with the save were not applied; PATCH /v1/cards/{cardId} to add them.",
            "enum": [
              true,
            ],
            "type": "boolean",
          },
          "status": {
            "description": "Always \`created\`, also for a re-save: check \`resaved\`.",
            "enum": [
              "created",
            ],
            "type": "string",
          },
          "wasArchived": {
            "description": "Present and true when the re-saved card was archived; it is back in the library.",
            "enum": [
              true,
            ],
            "type": "boolean",
          },
        },
        "required": [
          "appUrl",
          "cardId",
          "status",
        ],
        "type": "object",
      },
