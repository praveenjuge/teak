    "/v1/cards/{cardId}/highlights": {
      "get": {
        "description": "Passages highlighted in a link's article, in the order they appear in it; ones not found in the saved article come last.",
        "operationId": "listHighlights",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/Highlight",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "items",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Highlights",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "Card not found",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "List a card's highlights",
      },
      "post": {
        "description": "Finds the quote in the card's saved article and highlights it: the first match, unless \`prefix\` or \`suffix\` points at another. A passage that overlaps a highlight merges with it, keeping the older note. A card holds up to 200 highlights, and a highlighted link keeps its saved copy and article: Refresh details and saving it again no longer replace them.",
        "operationId": "createHighlight",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HighlightCreateRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Highlight",
                },
              },
            },
            "description": "The passage was highlighted already, or the new highlight merged with one it overlapped",
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Highlight",
                },
              },
            },
            "description": "Highlight created",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "INVALID_INPUT: no quote, or a quote or note too long",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "Card not found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "NO_ARTICLE: the card isn't a link with a saved article, or is in Trash. HIGHLIGHT_LIMIT: the card has 200 highlights. CONFLICT: the card's saved article changed while the quote was being found; try again",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "QUOTE_NOT_FOUND: the article doesn't have the quote",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "RATE_LIMITED",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Highlight a passage",
      },
    },
    "/v1/cards/{cardId}/pin": {
      "patch": {
        "description": "Pins a card to the top of the library, or unpins it. A new pin goes first. Up to 12 cards can be pinned, and archiving or trashing a card unpins it.",
        "operationId": "setCardPinned",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinRequest",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card",
                },
              },
            },
            "description": "The card with its new \`isPinned\`. Pinning a pinned card, or unpinning one that isn't, changes nothing",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "PIN_LIMIT_REACHED: 12 cards are already pinned; unpin one first",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "Card not found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "CONFLICT: the card is archived; archived cards can't be pinned",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Pin or unpin a card",
      },
    },
    "/v1/cards/{cardId}/refresh": {
      "post": {
        "description": "Clears the card's AI summary, tags and transcript, then runs the whole processing pipeline again: link metadata, previews, summary, tags and transcript.",
        "operationId": "refreshCard",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "cardId": {
                      "type": "string",
                    },
                    "requestedAt": {
                      "type": "number",
                    },
                    "status": {
                      "const": "queued",
                      "type": "string",
                    },
                  },
                  "required": [
                    "cardId",
                    "requestedAt",
                    "status",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Processing queued. Poll GET /v1/cards/{cardId} until processingStatus settles",
          },
          "404": {
            "description": "Card not found",
          },
          "409": {
            "description": "The card is in Trash",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "Re-run too soon: once per card per minute and six cards per minute; \`retryAt\` and Retry-After say when to try again",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Refresh a card's details",
      },
    },
    "/v1/cards/{cardId}/restore": {
      "post": {
        "operationId": "restoreCard",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "204": {
            "description": "Card restored",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Restore a card from Trash",
      },
    },
    "/v1/cards/{cardId}/save-pdf": {
      "post": {
        "description": "Saves an arXiv link's paper as its own document card. Saving the same link again returns that card; a save still running answers 409 IN_PROGRESS. Counts as a new card toward the plan's limit.",
        "operationId": "saveCardPdf",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedPdf",
                },
              },
            },
            "description": "The document an earlier save made from this link, with \`created: false\`",
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedPdf",
                },
              },
            },
            "description": "A new document card holding the paper's PDF",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "INVALID_INPUT: the card is not an arXiv link with a PDF (a withdrawn paper has none). CARD_LIMIT_REACHED: the free plan's card limit",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "Card not found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "CONFLICT: the card is in Trash. IN_PROGRESS: a save of this PDF is still running; try again in a moment",
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "FILE_TOO_LARGE: the PDF is over 100 MB",
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "UNSUPPORTED_TYPE: arXiv didn't answer with a PDF",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "RATE_LIMITED: 30 new cards a minute, as for creating cards",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "SERVICE_UNAVAILABLE: arXiv couldn't be reached",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Save a paper's PDF",
      },
    },
    "/v1/cards/{cardId}/thumbnail": {
      "delete": {
        "description": "Goes back to the image Teak found for the link and deletes the uploaded one.",
        "operationId": "resetCardThumbnail",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card",
                },
              },
            },
            "description": "The card, back on the image Teak found (or its screenshot). Resetting a card without a chosen image changes nothing",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "TYPE_MISMATCH: not a link card. UNSUPPORTED_TYPE: not an accepted image type (JPEG, PNG, WebP, GIF (its first frame) or AVIF. SVG and HEIC are refused.). INVALID_INPUT: the image couldn't be read, or is over 10,000 pixels on a side",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "The card, or the upload for it, was not found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "The card is in Trash",
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "FILE_TOO_LARGE: images must be under 20 MB",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "RATE_LIMITED: 20 image changes a minute; \`retryAt\` and Retry-After say when to try again",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Reset a link's image",
      },
      "put": {
        "description": "Uses an uploaded image as the link card's image. It stays through Refresh details and new link previews until it is reset.",
        "operationId": "setCardThumbnail",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "fileKey": {
                    "description": "From POST /v1/cards/{cardId}/thumbnail/upload, for this card",
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "fileKey",
                ],
                "type": "object",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card",
                },
              },
            },
            "description": "The card, showing the new image as linkPreviewImageUrl with thumbnailOverridden true",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "TYPE_MISMATCH: not a link card. UNSUPPORTED_TYPE: not an accepted image type (JPEG, PNG, WebP, GIF (its first frame) or AVIF. SVG and HEIC are refused.). INVALID_INPUT: the image couldn't be read, or is over 10,000 pixels on a side",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "The card, or the upload for it, was not found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "The card is in Trash",
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "FILE_TOO_LARGE: images must be under 20 MB",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "RATE_LIMITED: 20 image changes a minute; \`retryAt\` and Retry-After say when to try again",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Replace a link's image",
      },
    },
    "/v1/cards/{cardId}/thumbnail/upload": {
      "post": {
        "description": "Starts replacing a link card's image. Works at the free plan's card limit: no card is created.",
        "operationId": "createThumbnailUpload",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "fileSize": {
                    "description": "Bytes; at most 20971520 (20 MB).",
                    "type": "number",
                  },
                  "mimeType": {
                    "description": "JPEG, PNG, WebP, GIF (its first frame) or AVIF. SVG and HEIC are refused.",
                    "enum": [
                      "image/jpeg",
                      "image/png",
                      "image/webp",
                      "image/gif",
                      "image/avif",
                    ],
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "fileSize",
                  "mimeType",
                ],
                "type": "object",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateUploadResponse",
                },
              },
            },
            "description": "A signed URL. PUT the bytes to uploadUrl with the same Content-Type, then pass fileKey to PUT /v1/cards/{cardId}/thumbnail",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "TYPE_MISMATCH: not a link card. UNSUPPORTED_TYPE: not an accepted image type (JPEG, PNG, WebP, GIF (its first frame) or AVIF. SVG and HEIC are refused.). INVALID_INPUT: the image couldn't be read, or is over 10,000 pixels on a side",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "The card, or the upload for it, was not found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "The card is in Trash",
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "FILE_TOO_LARGE: images must be under 20 MB",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "RATE_LIMITED: 20 image changes a minute; \`retryAt\` and Retry-After say when to try again",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Upload a link's image",
      },
    },
    "/v1/exports": {
      "post": {
        "description": "One export can run at a time, and one can be started every 7 days. Poll GET /v1/exports/latest for progress and the download URL. The ZIP holds manifest.json, cards.json, the original files under files/, bookmarks.html (Netscape bookmark format) and cards.csv. manifest.json reports \`schemaVersion: 2\`: each card in cards.json also has \`aiTags\`, \`aiSummary\`, \`metadataTitle\`, \`isArchived\` and \`folders\` (names). A card saved from a page also has \`sourceUrl\` and \`sourceTitle\`.",
        "operationId": "startExport",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/ExportJob",
                    },
                  },
                  "required": [
                    "job",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Export started",
          },
          "409": {
            "description": "An export is already running; body includes \`job\`",
          },
          "429": {
            "description": "An export already ran in the last 7 days; \`retryAt\` and Retry-After say when the next can start",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Start a ZIP export of every card and original file",
      },
    },
    "/v1/exports/latest": {
      "get": {
        "operationId": "getLatestExport",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "canStartNew": {
                      "type": "boolean",
                    },
                    "job": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/ExportJob",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                    "nextAvailableAt": {
                      "description": "When the next export can start, or null if one can start now",
                      "type": [
                        "number",
                        "null",
                      ],
                    },
                  },
                  "required": [
                    "job",
                    "canStartNew",
                    "nextAvailableAt",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Latest export, or null if there has never been one",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Get the latest export and its download URL",
      },
    },
