      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Update highlight note",
    },
    "description": "Write, change or clear (null) a highlight's note. Get highlight ids from teak_v1_list_highlights.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "highlightId": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
