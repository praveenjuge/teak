  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Get folder",
    },
    "description": "Get one folder by id: its name, color, kind, card count (null for a smart folder, which has a \`query\`), a manual folder's \`rules\`, and its latest \`ruleRunId\`.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "folderId": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string",
        },
      },
      "required": [
        "folderId",
      ],
      "type": "object",
    },
    "name": "teak_v1_get_folder",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Create folder",
    },
    "description": "Create a folder. Names are unique per account, ignoring case. With kind "smart" and a \`query\` (the search grammar of teak_v1_search_cards, e.g. "tag:design type:link"), it saves a search: its cards are whatever matches, and cards cannot be added to it. A manual folder can have rules: \`autoTags\` are added to every card that joins it, and \`autoFileQuery\` (the same grammar, without like: or mood:) files matching cards into it once their AI tags are written. Saving a rule runs it over the existing cards; follow \`ruleRunId\` with teak_v1_get_folder_rule_run.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "autoFileEnabled": {
          "description": "False pauses the auto-file search without clearing it.",
          "type": "boolean",
        },
        "autoFileQuery": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "A search, with the qualifiers \`q\` accepts except \`like:\` and \`mood:\`, that files matching cards into this manual folder; at most 500 characters, or null to clear it.",
        },
        "autoTags": {
          "description": "Tags every card that joins this manual folder gets, at most 10. An empty array clears them. Up to 50 folders per account can have rules.",
          "items": {
            "type": "string",
          },
          "maxItems": 10,
          "type": "array",
        },
        "color": {
          "description": "A palette color.",
          "enum": [
            "gray",
            "red",
            "orange",
            "amber",
            "green",
            "teal",
            "blue",
            "violet",
            "pink",
          ],
          "type": "string",
        },
        "kind": {
          "description": "\`smart\` saves a search as a folder and needs \`query\`. Defaults to \`manual\`.",
          "enum": [
            "manual",
            "smart",
          ],
          "type": "string",
        },
        "name": {
          "description": "1 to 300 characters, unique per account ignoring case.",
          "maxLength": 300,
          "minLength": 1,
          "type": "string",
        },
        "query": {
          "description": "A smart folder's search, with the qualifiers \`q\` accepts; at most 500 characters. A \`folder:\` must name one of your manual folders.",
          "maxLength": 500,
          "type": "string",
        },
      },
      "required": [
        "name",
      ],
      "type": "object",
    },
    "name": "teak_v1_create_folder",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Update folder",
    },
    "description": "Rename a folder, change its color (null clears it), change a smart folder's query, or change a manual folder's rules: \`autoTags\` ([] clears them), \`autoFileQuery\` (null clears it) and \`autoFileEnabled\` (false pauses it). New tags or a new or resumed search start a rule run over the existing cards; follow \`ruleRunId\` with teak_v1_get_folder_rule_run.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "autoFileEnabled": {
          "description": "False pauses the auto-file search without clearing it.",
          "type": "boolean",
        },
        "autoFileQuery": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "A search, with the qualifiers \`q\` accepts except \`like:\` and \`mood:\`, that files matching cards into this manual folder; at most 500 characters, or null to clear it.",
        },
        "autoTags": {
          "description": "Tags every card that joins this manual folder gets, at most 10. An empty array clears them. Up to 50 folders per account can have rules.",
          "items": {
            "type": "string",
          },
          "maxItems": 10,
          "type": "array",
        },
        "color": {
          "anyOf": [
            {
              "enum": [
                "gray",
                "red",
                "orange",
                "amber",
                "green",
                "teal",
                "blue",
                "violet",
                "pink",
              ],
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "A palette color, or null to clear it.",
        },
        "folderId": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string",
        },
        "name": {
          "description": "1 to 300 characters, unique per account ignoring case.",
          "maxLength": 300,
          "minLength": 1,
          "type": "string",
        },
        "query": {
          "description": "A smart folder's new search (at most 500 characters). Manual folders have none.",
          "maxLength": 500,
          "type": "string",
        },
      },
      "required": [
        "folderId",
      ],
      "type": "object",
    },
    "name": "teak_v1_update_folder",
  },
  {
