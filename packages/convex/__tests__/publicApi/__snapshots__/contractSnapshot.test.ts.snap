          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "RATE_LIMITED",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Unmark a link done",
      },
      "post": {
        "description": "Marks a link card read, watched, listened, bought, cooked, played or done, depending on its category. Only link cards can be marked done.",
        "operationId": "markCardDone",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card",
                },
              },
            },
            "description": "The card with \`completedAt\` set. Marking a card that is already done keeps its first \`completedAt\`",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "TYPE_MISMATCH: only link cards can be marked done",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "Card not found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "The card is in Trash",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "RATE_LIMITED",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Mark a link done",
      },
    },
    "/v1/cards/{cardId}/favorite": {
      "patch": {
