        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PinnedCardsResponse",
                },
              },
            },
            "description": "The pinned cards in their new order",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "INVALID_INPUT: \`cardIds\` doesn't list every pinned card exactly once",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Reorder pinned cards",
      },
    },
    "/v1/cards/{cardId}": {
      "delete": {
        "operationId": "deleteCard",
        "parameters": [
          {
            "description": "Permanently remove a card that is already in Trash, and its files, when true; otherwise move the card to Trash.",
            "in": "query",
            "name": "permanent",
            "schema": {
              "type": "boolean",
            },
          },
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "204": {
            "description": "Card deleted",
          },
          "404": {
            "description": "Card not found",
          },
          "409": {
            "description": "NOT_IN_TRASH: permanent deletes need the card in Trash first",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Delete a card",
      },
      "get": {
        "operationId": "getCard",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card",
                },
              },
            },
            "description": "Card details",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Get a card",
      },
      "patch": {
        "operationId": "updateCard",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCardRequest",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card",
                },
              },
            },
            "description": "Updated card",
          },
          "409": {
            "description": "CONFLICT: the link has highlights, so its \`url\` can't change until they are removed",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Update a card",
      },
    },
    "/v1/cards/{cardId}/content": {
      "get": {
        "operationId": "getCardContent",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Which text to return when a card has more than one. Without it the response is a document's text, then a transcript, then a note's content, and never \`article\`: ask for \`article\` to get a link's article.",
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "enum": [
                "article",
                "document",
                "transcript",
                "content",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "cardId": {
                      "type": "string",
                    },
                    "charCount": {
                      "description": "Characters in the full stored text",
                      "type": "number",
                    },
                    "kind": {
                      "description": "document: text extracted from the card's file (PDF, Word, PowerPoint, text or code). transcript: the speech in its audio or video. content: a text or quote card's written text. article: a link's article from its saved copy, as Markdown whose images are signed URLs valid for 7 days; returned only for \`?kind=article\`.",
                      "enum": [
                        "document",
                        "transcript",
                        "content",
                        "article",
                      ],
                      "type": "string",
                    },
                    "text": {
                      "type": "string",
                    },
                    "truncated": {
                      "description": "True when text is not the document's whole text. Teak keeps the first 500 pages of a PDF and at most 524,288 characters; when the stored text can't be read, its first 32 KiB is returned and text is shorter than charCount",
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "cardId",
                    "kind",
                    "text",
                    "charCount",
                    "truncated",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "The card's full stored text",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "INVALID_INPUT: \`kind\` isn't one of the listed kinds",
          },
          "404": {
            "description": "Card not found, or NO_CONTENT: the card has no stored text (of that \`kind\`, when given)",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Get a card's text",
      },
    },
    "/v1/cards/{cardId}/done": {
      "delete": {
        "description": "Clears a link card's done state.",
        "operationId": "unmarkCardDone",
        "parameters": [
          {
            "in": "path",
            "name": "cardId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
