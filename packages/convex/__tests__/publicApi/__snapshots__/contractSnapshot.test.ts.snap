      "HealthResponse": {
        "properties": {
          "service": {
            "type": "string",
          },
          "status": {
            "type": "string",
          },
          "version": {
            "type": "string",
          },
        },
        "required": [
          "service",
          "status",
          "version",
        ],
        "type": "object",
      },
      "Highlight": {
        "description": "A passage highlighted in a link's article, with an optional note.",
        "properties": {
          "anchored": {
            "description": "False while Teak hasn't found the quote in the card's saved article: an imported highlight waiting for the article, or one the article doesn't have.",
            "type": "boolean",
          },
          "cardId": {
            "type": "string",
          },
          "createdAt": {
            "type": "number",
          },
          "id": {
            "type": "string",
          },
          "note": {
            "type": [
              "string",
              "null",
            ],
          },
          "quote": {
            "description": "The highlighted text.",
            "type": "string",
          },
          "source": {
            "description": "Where it was made: in Teak's reader, through this API, or by an import. Clients should accept values they don't know.",
            "enum": [
              "reader",
              "api",
              "import",
            ],
            "type": "string",
          },
          "updatedAt": {
            "type": "number",
          },
        },
        "required": [
          "id",
          "cardId",
          "quote",
          "note",
          "anchored",
          "source",
          "createdAt",
          "updatedAt",
        ],
        "type": "object",
      },
      "HighlightCreateRequest": {
        "properties": {
          "note": {
            "description": "At most 2,000 characters.",
            "type": "string",
          },
          "prefix": {
            "description": "Text just before the quote, to pick one of its repeats. Without it, or \`suffix\`, the first match is highlighted.",
            "type": "string",
          },
          "quote": {
            "description": "Text from the card's article, at most 5,000 characters. Whitespace, curly quotes, dash styles and case don't need to match.",
            "type": "string",
          },
          "suffix": {
            "description": "Text just after the quote, to pick one of its repeats.",
            "type": "string",
          },
        },
        "required": [
          "quote",
        ],
        "type": "object",
      },
      "HighlightUpdateRequest": {
        "properties": {
          "note": {
            "description": "The new note, at most 2,000 characters, or null to clear it.",
            "type": [
              "string",
              "null",
            ],
          },
        },
        "required": [
          "note",
        ],
        "type": "object",
      },
      "PinOrderRequest": {
        "additionalProperties": false,
        "properties": {
          "cardIds": {
            "description": "Every pinned card's id exactly once, first to last. At most 12.",
            "items": {
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 12,
            "type": "array",
          },
        },
        "required": [
          "cardIds",
        ],
        "type": "object",
      },
      "PinRequest": {
        "additionalProperties": false,
        "properties": {
          "isPinned": {
            "type": "boolean",
          },
        },
        "required": [
          "isPinned",
        ],
        "type": "object",
      },
      "PinnedCardsResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CardListItem",
            },
            "type": "array",
          },
        },
        "required": [
          "items",
        ],
        "type": "object",
      },
      "SavedPdf": {
        "properties": {
          "cardId": {
            "description": "The document card holding the PDF",
            "type": "string",
          },
          "created": {
            "description": "False when an earlier save already made the card",
            "type": "boolean",
          },
        },
        "required": [
          "cardId",
          "created",
        ],
        "type": "object",
      },
      "TagOperation": {
        "description": "A library-wide tag change. It rewrites user and AI tags on every card, including cards in Trash and Archive, matching the tag ignoring case.",
        "properties": {
          "changed": {
            "description": "Cards rewritten so far.",
            "type": "number",
          },
          "completedAt": {
            "type": [
              "number",
              "null",
            ],
          },
          "createdAt": {
            "type": "number",
          },
          "error": {
            "type": [
              "string",
              "null",
            ],
          },
          "from": {
            "description": "The tag being changed, lowercased.",
            "type": "string",
          },
          "id": {
            "type": "string",
          },
          "kind": {
            "enum": [
              "rename",
              "merge",
              "delete",
            ],
            "type": "string",
          },
          "processed": {
            "description": "Cards looked at so far.",
            "type": "number",
          },
          "status": {
            "enum": [
              "running",
              "completed",
              "failed",
            ],
            "type": "string",
          },
          "to": {
            "description": "The new name (rename) or the tag merged into (merge).",
            "type": [
              "string",
              "null",
            ],
          },
          "total": {
            "description": "Cards carrying the tag when the change started (counted up to 10000).",
            "type": "number",
          },
          "updatedAt": {
            "type": "number",
          },
        },
        "required": [
          "id",
          "kind",
          "from",
          "to",
          "status",
          "total",
          "processed",
          "changed",
          "error",
          "createdAt",
          "updatedAt",
          "completedAt",
        ],
        "type": "object",
      },
      "TagOperationStarted": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TagOperation",
          },
          {
            "properties": {
              "operationId": {
                "description": "Poll GET /v1/tags/operations/{operationId}.",
                "type": "string",
              },
            },
            "required": [
              "operationId",
            ],
            "type": "object",
          },
        ],
      },
      "TagSummary": {
        "properties": {
          "count": {
            "type": "number",
          },
          "name": {
            "type": "string",
          },
        },
        "required": [
          "count",
          "name",
        ],
        "type": "object",
      },
      "TagsResponse": {
        "properties": {
          "isComplete": {
            "description": "False when a very large library reached the listing's read limit and some tags or counts are missing.",
            "type": "boolean",
          },
          "items": {
            "description": "Lowercase tag names on cards outside Trash and Archive, including tags Teak added, with the number of cards that have each. Any name works as the \`tag\` filter on GET /v1/cards.",
            "items": {
              "$ref": "#/components/schemas/TagSummary",
            },
            "type": "array",
          },
        },
        "required": [
          "isComplete",
          "items",
        ],
        "type": "object",
      },
      "UpdateCardRequest": {
        "properties": {
          "addColors": {
            "description": "Palette cards only. Hex codes to add, such as #FF5500 or f50. A color the palette has is skipped, and a palette holds up to 12 colors.",
            "items": {
              "type": "string",
            },
            "maxItems": 12,
            "minItems": 1,
            "type": "array",
          },
          "content": {
            "description": "Replacement card content. Text-card Markdown is preserved exactly and is limited to 512 KiB measured in UTF-8 bytes.",
            "example": 
"---
title: Notes
---

# Heading  
"
,
            "type": "string",
          },
          "folderIds": {
            "description": "Replaces the card's folders with these folder ids (at most 50). An empty list takes it out of every folder.",
            "items": {
              "type": "string",
            },
            "maxItems": 50,
            "type": "array",
          },
          "isArchived": {
            "description": "True archives the card (hides it from the library without deleting it); false returns it to the library.",
            "type": "boolean",
          },
          "metadataTitle": {
            "description": "Replacement title. Whitespace is trimmed and a longer title is cut to 512 characters. Null or a blank string clears it.",
            "type": [
              "string",
              "null",
            ],
          },
          "notes": {
            "type": [
              "string",
              "null",
            ],
          },
          "removeAiTags": {
            "description": "AI tags to remove from the card. Tags Teak didn't add are ignored.",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "removeColors": {
            "description": "Palette cards only. Hex codes to remove; every copy of each goes, and colors the palette doesn't have are ignored. A palette keeps at least one color. Removes apply before addColors, so one request can swap a color.",
            "items": {
              "type": "string",
            },
            "maxItems": 12,
            "minItems": 1,
            "type": "array",
          },
          "tags": {
            "description": "Replaces the card's own tags.",
            "items": {
              "maxLength": 64,
              "type": "string",
            },
            "type": "array",
          },
          "url": {
            "type": "string",
          },
        },
        "type": "object",
      },
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "OAuth access token or teakapi_ API key",
        "description": "Bearer token. Accepts either an OAuth 2.0 access token (obtained via browser sign-in; expires after 1 hour and is refreshable) or a teakapi_ API key.",
        "scheme": "bearer",
        "type": "http",
      },
      "connectRevocation": {
        "bearerFormat": "WorkOS Connect API access JWT",
        "description": "Signed Connect token for https://teakvault.com/api. New application-wide disconnects require a live access token. Expired tokens can replay a completed receipt or resume an already acknowledged operation; API keys, refresh tokens and session tokens are rejected.",
        "scheme": "bearer",
        "type": "http",
      },
    },
  },
  "info": {
    "description": "Public API for creating, querying, and syncing Teak cards. A 429 response carries Retry-After, RateLimit-Remaining, and RateLimit-Reset in seconds, plus RateLimit-Limit when the limit is known. A 503 SERVICE_UNAVAILABLE response means the service was briefly busy; retry after its Retry-After seconds.",
    "title": "Teak API",
    "version": "v1",
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse",
                },
              },
            },
            "description": "Service health",
          },
        },
        "summary": "Health check",
      },
    },
    "/v1": {
      "get": {
        "operationId": "getApiDiscovery",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryResponse",
                },
              },
            },
            "description": "API discovery",
          },
        },
        "summary": "List v1 endpoints",
      },
    },
    "/v1/cards": {
      "get": {
        "operationId": "listCards",
        "parameters": [
          {
            "description": "Search text with optional qualifiers: tag:name or #name, type:link, is:fav, is:pinned (cards pinned to the top), is:archived, is:done (links marked done), is:todo (links to read, watch or buy that are not done yet), site:github.com, folder:"Reading list", like:<cardId> (the cards closest in meaning to that card), mood:"moody brutalist" (images by mood), price:<100 (also >, <=, >= and =; only links with a price match), text:"total due" (only the words Teak read in images, video thumbnails, link previews and scanned PDFs) and "quoted phrases". A - before a word, phrase or qualifier leaves those cards out (design -figma, -tag:old; not like: or mood:), uppercase OR matches either side (tag:fonts OR tag:type), and parentheses group: (site:github.com OR site:gitlab.com) -is:archived. Qualifiers combine with the other filters. A \`-\` binds tightest, then a space, then \`OR\`; lowercase \`or\` and a \`-\` inside a word (\`to-do\`) are plain text. Several \`price:\` bounds make a range. Cards tagged \`secret\` or \`hidden\` (\`isHidden\`) are left out of every list unless the search names one of those tags: \`q=#secret\`, \`q=tag:hidden\` or \`tag=secret\` (\`-tag:hidden\` never shows them, and \`tag:hidden OR tag:x\` shows them only through the \`tag:hidden\` side). The plain word \`secret\` does not show them.",
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "A card id: only the cards closest to it in meaning, of any type, never the card itself (the same as \`like:<id>\` in \`q\`). Other parameters narrow them and \`sort\` orders them. A malformed id returns \`400 INVALID_INPUT\`; a card in Trash or not found returns no items with \`similarity: "unavailable"\`.",
            "in": "query",
            "name": "similarTo",
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "How \`q\` finds cards: \`hybrid\` (default) matches words and meaning, so \`cozy reading nook\` also finds a photo of an armchair by a window; \`keyword\` matches words only; \`semantic\` matches meaning only. Filters, qualifiers and \`sort\` apply in every mode. The response's \`searchMode\` says which ran.",
            "in": "query",
            "name": "mode",
            "schema": {
              "default": "hybrid",
              "enum": [
                "hybrid",
                "keyword",
                "semantic",
              ],
              "type": "string",
            },
          },
          {
            "description": "Page size, default 50. A whole number above 100 returns 100; anything that isn't a whole number from 1 up is \`400 INVALID_INPUT\`.",
            "in": "query",
            "name": "limit",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Order by the date each card was last saved (\`savedAt\`): \`newest\` (default) or \`oldest\`. Saving a link that's already in Teak moves its card to the top of \`newest\`; an imported card keeps its original date. Or \`shuffle\`: a stable random order picked by \`shuffleSeed\`. A search, tag or folder shuffles its matches (a search its best 400, a tag or folder its newest 2,000). Or \`relevance\` (Best match), with \`q\`: the search's top 64 results by how well they match its words, then the rest in search order. Without \`q\` it is \`newest\`. The response's \`relevanceRanked\` says whether the top results were scored; the first page decides, and every later page keeps its order.",
            "in": "query",
            "name": "sort",
            "schema": {
              "enum": [
                "newest",
                "oldest",
                "relevance",
                "shuffle",
              ],
              "type": "string",
            },
          },
          {
            "description": "Required with \`sort=shuffle\`: a whole number from 0 to 2147483647. The same seed gives the same order on every page and device; pick a new one to reshuffle. A \`cursor\` only works with the seed that issued it.",
            "in": "query",
            "name": "shuffleSeed",
            "schema": {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer",
            },
          },
          {
            "description": "Repeat to match any selected card type, for example type=image&type=link.",
            "explode": true,
            "in": "query",
            "name": "type",
            "schema": {
              "items": {
                "enum": [
                  "text",
                  "link",
                  "image",
                  "video",
                  "audio",
                  "document",
                  "palette",
                  "quote",
                ],
                "type": "string",
              },
              "type": "array",
            },
            "style": "form",
          },
          {
            "in": "query",
            "name": "tag",
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "favorited",
            "schema": {
              "type": "boolean",
            },
          },
          {
            "description": "Only cards pinned to the top of the library, like \`q=is:pinned\`. Without a search, the pinned cards come back in their pinned order as one page.",
            "in": "query",
            "name": "pinned",
            "schema": {
              "type": "boolean",
            },
          },
          {
            "description": "List only cards in Trash when true.",
            "in": "query",
            "name": "trashed",
            "schema": {
              "type": "boolean",
            },
          },
          {
            "description": "Only cards in this folder; for a smart folder, the cards its search matches (combined with \`q\`). An unknown folder returns 404.",
            "in": "query",
            "name": "folder",
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Archived cards to list: \`exclude\` (the default) leaves them out, \`only\` lists just them, \`include\` lists them with the rest. Trash lists every trashed card whatever this says.",
            "in": "query",
            "name": "archived",
            "schema": {
              "enum": [
                "exclude",
                "only",
                "include",
              ],
              "type": "string",
            },
          },
          {
            "description": "Repeat to match any selected value within this filter.",
            "explode": true,
            "in": "query",
            "name": "style",
            "schema": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "style": "form",
          },
          {
            "description": "Repeat to match any selected value within this filter.",
            "explode": true,
            "in": "query",
            "name": "hue",
            "schema": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "style": "form",
          },
          {
            "description": "Repeat to match any selected value within this filter.",
            "explode": true,
            "in": "query",
            "name": "hex",
            "schema": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "style": "form",
          },
          {
            "in": "query",
            "name": "createdAfter",
            "schema": {
              "type": "number",
            },
          },
          {
            "in": "query",
            "name": "createdBefore",
            "schema": {
              "type": "number",
            },
          },
          {
            "description": "Comma-separated values: content, metadata, processing",
            "in": "query",
            "name": "include",
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardsPageResponse",
                },
              },
            },
            "description": "Paginated card list",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "Invalid request",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "List cards",
      },
      "post": {
        "description": "Saves a card. Saving a link that's already in Teak makes no second card: when the save is just the link (\`url\`, or \`content\` that is only the link) and a card outside Trash has the same link, ignoring \`http\`/\`https\`, \`www.\`, a trailing slash, a \`#fragment\` and \`utm_*\`/\`fbclid\`/\`gclid\` parameters, that card moves to the top of \`sort=newest\` and comes back from Archive. The response is still \`status: "created"\` with code 200, plus \`resaved: true\` (and \`wasArchived: true\` when it was archived). Tags and notes sent with a re-save are ignored; PATCH the card to add them. A re-save counts toward the rate limit but not the free plan's card limit. A link with other text in \`content\` always makes a new card. Replaying an \`Idempotency-Key\` returns the first response.",
        "operationId": "createCard",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCardRequest",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCardResponse",
                },
              },
            },
            "description": "Created card",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Create a card",
      },
    },
    "/v1/cards/bulk": {
      "post": {
        "operationId": "bulkCards",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkCardsRequest",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkCardsResponse",
                },
              },
            },
            "description": "Bulk operation result",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Execute bulk card operations",
      },
    },
    "/v1/cards/changes": {
      "get": {
        "operationId": "listCardChanges",
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "required": true,
            "schema": {
              "type": "number",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Page size, default 50. A whole number above 100 returns 100; anything that isn't a whole number from 1 up is \`400 INVALID_INPUT\`.",
            "in": "query",
            "name": "limit",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardChangesResponse",
                },
              },
            },
            "description": "Incremental card changes",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "INVALID_INPUT: \`since\` isn't a number, or \`limit\` isn't a whole number from 1 up",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "List card changes since a timestamp",
      },
    },
    "/v1/cards/duplicate": {
      "get": {
        "description": "Matches a card outside Trash saved from the same link, ignoring \`http\`/\`https\`, a leading \`www.\`, a trailing slash, a \`#fragment\` (except \`#/\` and \`#!\` routes) and \`utm_*\`, \`fbclid\` and \`gclid\` parameters. Other parameters, their order and the path's case count. Archived cards match; when several do, the newest is returned. Percent-encode \`#\` in the \`url\` parameter, or the client drops the fragment before sending.",
        "operationId": "findDuplicateCard",
        "parameters": [
          {
            "in": "query",
            "name": "url",
            "required": true,
            "schema": {
              "format": "uri",
              "maxLength": 8192,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "cardId": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                  },
                  "required": [
                    "cardId",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Matching card ID, or null",
          },
          "400": {
            "description": "Invalid URL",
          },
          "401": {
            "description": "Invalid or revoked credentials",
          },
          "429": {
            "description": "Rate limit exceeded",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Find a non-deleted card saved from the same link",
      },
    },
    "/v1/cards/pinned/order": {
      "put": {
        "description": "Sets the order of the cards pinned to the top of the library. List every pinned card's id once, first to last; get them with \`GET /v1/cards?pinned=true\`.",
        "operationId": "reorderPinnedCards",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinOrderRequest",
              },
            },
          },
