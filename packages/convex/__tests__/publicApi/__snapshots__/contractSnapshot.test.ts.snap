    "/v1/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "properties": {
                        "cardCount": {
                          "description": "Cards outside Trash",
                          "type": "number",
                        },
                        "cardLimit": {
                          "description": "Free plan card limit; null on Pro",
                          "type": [
                            "number",
                            "null",
                          ],
                        },
                        "email": {
                          "format": "email",
                          "type": "string",
                        },
                        "id": {
                          "description": "Permanent Teak owner ID",
                          "type": "string",
                        },
                        "locale": {
                          "description": "The account's Teak language, chosen in Settings: a BCP 47 code such as en, de or pt-BR. More languages may be added, so treat an unknown code as English.",
                          "type": "string",
                        },
                        "name": {
                          "type": "string",
                        },
                        "plan": {
                          "enum": [
                            "free",
                            "pro",
                          ],
                          "type": "string",
                        },
                        "settingsUrl": {
                          "description": "Teak web Settings, where plan, billing, API keys and import live",
                          "format": "uri",
                          "type": "string",
                        },
                      },
                      "required": [
                        "id",
                        "email",
                        "locale",
                      ],
                      "type": "object",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Permanent Teak owner ID and current profile",
          },
          "401": {
            "description": "Missing, invalid, expired, or revoked credential",
          },
          "429": {
            "description": "Rate limit exceeded",
          },
          "500": {
            "description": "Profile or authorization service unavailable",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Get the authenticated Teak identity",
      },
    },
    "/v1/oauth/disconnect": {
      "post": {
        "description": "No request body. Revokes this application on all installations for the signed-in user, while other applications stay connected. Old consent receipts remain permanently denied and successful retries return 204 without revoking a later grant. Works after authentication rollback. Reconnect may wait up to 305 seconds while old access tokens expire. Preserve local credentials unless 204 is returned; refresh an expired access token after 401 and retry.",
        "operationId": "disconnectOAuthConsent",
        "responses": {
          "204": {
            "description": "Application disconnected or completed old receipt replayed",
          },
          "401": {
            "description": "Invalid or expired token, or conflicting consent binding",
          },
          "503": {
            "description": "Disconnect pending or unavailable; preserve credentials and retry",
          },
        },
        "security": [
          {
            "connectRevocation": [],
          },
        ],
        "summary": "Disconnect this WorkOS Connect application",
      },
    },
    "/v1/page-snapshots/upload": {
      "post": {
        "description": "For a browser extension saving the page someone is looking at: the rendered HTML, gzipped, becomes the link's saved copy, so pages behind a sign-in or built by scripts are kept as they were seen. Teak keeps a private copy of each link's page either way; without a snapshot it fetches the page itself.",
        "operationId": "createPageSnapshotUpload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePageSnapshotUploadRequest",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateUploadResponse",
                },
              },
            },
            "description": "A signed URL. PUT the gzipped page to uploadUrl with Content-Type: application/gzip and exactly \`bytes\` bytes, then pass fileKey as pageSnapshotKey to POST /v1/cards",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "INVALID_INPUT: \`bytes\` is missing or not a whole number",
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "PAGE_SNAPSHOT_TOO_LARGE: over 20 MiB gzipped",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "RATE_LIMITED: 60 snapshots a minute; \`retryAt\` and Retry-After say when to try again",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Upload the page a link was saved from",
      },
    },
    "/v1/tags": {
      "get": {
        "operationId": "listTags",
        "responses": {
