          },
          "savedAt": {
            "description": "When the card was last saved. It starts equal to \`createdAt\` and moves to the time of the save when you save the same link again (POST /v1/cards answers \`resaved: true\`). \`sort=newest\` and \`sort=oldest\` order by it. \`createdAt\` stays the date the card was first saved.",
            "type": "number",
