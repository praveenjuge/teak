            "type": [
              "string",
              "null",
            ],
          },
          "sourceUrl": {
            "description": "The page the card was saved from, such as the page a quote was selected on. Set when the card is created; \`site:\` matches its host when the card has no \`url\`. Not the same as \`source\`, the free label sent at create.",
