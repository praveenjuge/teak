          "enum": [
            "create",
            "update",
            "favorite",
            "delete",
            "archive",
            "unarchive",
            "addTags",
            "removeTags",
            "restore",
          ],
          "type": "string",
        },
      },
      "required": [
        "operation",
        "items",
      ],
      "type": "object",
    },
    "name": "teak_v1_bulk_cards",
  },
