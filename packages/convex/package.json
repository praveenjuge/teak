{
  "name": "@teak/convex",
  "version": "1.0.91",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./shared": "./shared/index.ts",
    "./_generated/api": "./_generated/api.js",
    "./_generated/dataModel": "./_generated/dataModel.js",
    "./*": "./*.ts"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "dev": "bun --no-env-file ../../scripts/convex-dev.ts",
    "lint": "biome lint --only=plugin .",
    "test": "bun run test:unit && bun run test:edge",
    "test:edge": "SITE_URL=http://localhost:3000 vitest run --config vitest.config.ts",
    "test:unit": "SITE_URL=http://localhost:3000 bun test __tests__ --coverage --dots --isolate",
    "typecheck": "tsc --noEmit && bun run typecheck:tests",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.edge.json"
  },
  "dependencies": {
    "@cf-wasm/photon": "catalog:",
    "@convex-dev/polar": "^0.9.2",
    "@convex-dev/rate-limiter": "0.4.2",
    "@polar-sh/sdk": "^0.49.0",
    "@teak/files-protocol": "workspace:*",
    "@teak/i18n": "workspace:*",
    "@vllnt/convex-api-keys": "0.2.0",
    "convex": "catalog:",
    "convex-helpers": "catalog:",
    "hast-util-sanitize": "^5.0.2",
    "htmlparser2": "catalog:",
    "jose": "catalog:",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "micromark-extension-gfm": "^3.0.0",
    "react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "convex-test": "^0.0.61",
    "fflate": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
