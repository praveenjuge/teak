{
  "name": "@teak/tests",
  "version": "1.0.83",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "bun --no-env-file src/scripts/run-local-suite.ts",
    "e2e:auth:runtime": "playwright test --config=playwright.auth-runtime.config.ts",
    "e2e:docs": "playwright test --project=docs",
    "e2e:extension:runtime": "playwright test --config=playwright.oauth-runtime.config.ts",
    "e2e:stack": "bun --no-env-file src/scripts/run-local-suite.ts stack",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@teak/convex": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fflate": "0.8.3",
    "node-html-parser": "^9.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.4.0",
    "@workos/emulate": "0.14.0",
    "convex": "^1.46.0",
    "marked": "17.0.5",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3"
  }
}
